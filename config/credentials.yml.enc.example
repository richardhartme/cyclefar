# Template for config/credentials.yml.enc, which is not committed.
#
# This example is plain text. To create your own encrypted file, run
#
#   bin/rails credentials:edit
#
# (Rails generates config/credentials.yml.enc and config/master.key if they are missing)
# and add the keys below with your own values. Keep master.key private; both files are
# ignored by Git.

# Signs and encrypts sessions and cookies. Read by .kamal/secrets at deploy time and passed to
# the container as SECRET_KEY_BASE. Rails generates one for you.
secret_key_base: replace-with-output-of-bin-rails-secret

# Read by .kamal/secrets at deploy time.
kamal:
  registry_password: replace-with-container-registry-access-token

db:
  password: replace-with-production-database-password

# Active Record Encryption keys (encrypts the Intervals.icu API key). Generate once with
# bin/rails db:encryption:init and never change them once data is encrypted. Read by
# .kamal/secrets at deploy time unless the ACTIVE_RECORD_ENCRYPTION_* variables are set.
active_record_encryption:
  primary_key: replace-with-generated-primary-key
  deterministic_key: replace-with-generated-deterministic-key
  key_derivation_salt: replace-with-generated-key-derivation-salt
