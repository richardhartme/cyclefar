@startuml
!pragma layout smetana
' Scope and limitations: README.md
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title CycleFar — Completion, Adaptation and Replanning Components

LAYOUT_LEFT_RIGHT()

Person(rider, "Rider", "Completes, edits, moves or misses workouts; changes availability; records time off; and updates FTP.")
ContainerDb_Ext(database, "PostgreSQL database", "PostgreSQL", "Stores CycleFar's persistent training data.")

Container_Boundary(web_application, "CycleFar web application") {
  Component(controllers, "Workout and plan-change controllers", "Ruby on Rails controllers", "Scope workout, proposal and time-off lookups to Current.user; handle edits, feedback, schedule and settings.")
  Component(home, "HomeController and comparison view", "Rails / ERB", "Render owner-scoped Current / Proposed workout metrics and clamped bias; unavailable proposals offer Reject only.")
  Component(editor, "ManualEditor", "Workouts service", "Regenerates manual edits; acceptance saves the exact load-limited definition shown in the comparison.")
  Component(mover, "Mover", "Workouts service", "Preserves short same-context moves or regenerates from destination progression; rechecks weekly load and warnings.")
  Component(destination, "DestinationValidator", "Workouts service", "Shares Add/Copy/Move/missed Move exclusions: occupied, out-of-plan, unphased, time-off and target-event dates.")
  Component(load_review, "WeeklyLoadReview", "Planning service", "Reads destination weekly load and calendar-wide load without mutations; includes weeks beyond the detail horizon.")
  Component(freshness, "ProposalCreator and ProposalFreshness", "Adaptations services", "Save seven-day expiry and a digest of relevant canonical inputs; reject expired, stale, archived or unverifiable proposals without writes.")
  Component(manual_creation, "Creator and Copier", "Workouts services", "Add a generated workout or copy canonical steps to an empty plan date using current FTP.")
  Component(completion, "CompletionRecorder", "Adaptations service", "Materialises a due outline if needed; records feedback and current-FTP snapshots, then evaluates adaptations under the plan lock.")
  Component(evaluator, "FeedbackEvaluator", "Adaptations service", "Proposes same-subtype/family or broad-Intervals changes within today through day 13; nearby reductions and difficult-easy targets; optional global bias.")
  Component(comparison, "ProposalComparison", "Adaptations service", "Validates the complete source/target set through its plan and current horizon; computes current/proposed metrics and clamped global bias without writes.")
  Component(feedback_limits, "FeedbackLoadLimiter", "Adaptations service", "Previews fitted changes; preserves reduced-load ceilings and rechecks weekly caps against fixed workouts and forecasts.")
  Component(proposals, "ProposalApplier", "Adaptations service", "Locks plan then proposal; validates comparison, applies all edits and bias, and removes proposal atomically. Reject removes it.")
  Component(material_change, "MaterialChangeProposal and Replanner", "Planning services", "Offer an optional proposal after material Change; acceptance keeps that workout fixed and re-prescribes the following bounded 14 days.")
  Component(schedule_changes, "Schedule-change services", "Planning services", "MissedWorkoutResolver, AvailabilityChanger and TimeOffPlanner preserve history while changing the future schedule.")
  Component(prescriber, "FuturePrescriber", "Planning service", "Under the plan lock, replaces future planned prescriptions; retains unbiased baselines and post-break ceilings, preserves history and materializes the horizon.")
  Component(plan_builder, "PlanBuilder and ExistingPlanConfiguration", "Planning services", "Rebuild aligned recovery and staged taper forecasts for future prescriptions.")
  Component(return_rules, "ReturnRamp and PreBreakProgression", "Planning calculations", "Use the latest comparable planned/completed regular session; choose stage duration/power limits and resume from reduced progression after illness/recovery.")
  Component(materializer, "WorkoutBuilder", "Planning service", "Applies accepted bias once when outlines enter the next 14 days; saves fitted levels, steps and automatic load references under the plan lock.")
  Component(load_rules, "LoadContext, WeeklyLoadCap and LoadReduction", "Planning services", "Use shared RecoverySchedule flags, comparable-week rules and ceilings; apply ordered reductions while retaining hard-week duration and endurance profiles.")
  Component(progression, "Progression", "Training pure calculation", "Combines baseline and bias; clamps to 1-7 and reduced-load ceilings.")
  Component(ftp, "Settings::Update, FtpHistory and FtpRecalculator", "Settings and Planning services", "Record, edit and delete FTP history, sync current FTP from the newest reading and recalculate future structured-workout metrics without changing completed snapshots.")
  Component(engine, "Workout engine and TargetBandLimiter", "Workouts and Metrics services", "Generate definitions and metrics; constrain saved return main targets and every step ceiling, including sampled endurance profiles.")
  Component(models, "Plan and workout models", "Active Record", "Enforce validations and completed-workout immutability while persisting plans, workouts, steps, feedback, proposals, settings and time off.")
}

Rel(rider, controllers, "Changes training and records feedback", "HTTPS")
Rel(rider, home, "Reviews feedback proposals", "HTTPS")
Rel(home, comparison, "Requests read-only comparison")
Rel(home, load_review, "Reviews plan load after horizon materialisation")
Rel(controllers, editor, "Edits planned structured workouts")
Rel(controllers, material_change, "Creates optional material-change proposal")
Rel(material_change, prescriber, "Re-prescribes following block on acceptance")
Rel(material_change, models, "Reads proposal and preserves changed workout")
Rel(controllers, manual_creation, "Adds and copies workouts")
Rel(manual_creation, engine, "Generates definitions or recalculates copied metrics")
Rel(manual_creation, destination, "Validates Add/Copy dates under the plan lock")
Rel(manual_creation, models, "Persists new workout and steps")
Rel(controllers, mover, "Moves ordinary planned workouts")
Rel(schedule_changes, mover, "Uses the same Move service for missed Move")
Rel(mover, engine, "Regenerates across phase/context changes or moves over seven days")
Rel(mover, destination, "Validates destination under the plan lock; excludes source from collisions")
Rel(mover, load_review, "Returns destination load warnings")
Rel(mover, load_rules, "Keeps subtype/duration and limits regenerated destination load")
Rel(mover, models, "Saves destination, canonical steps and generation choices")
Rel(controllers, materializer, "Structures a due/overdue outline when opened")
Rel(completion, materializer, "Structures only a due/overdue completion source")
Rel(controllers, completion, "Records completion")
Rel(completion, evaluator, "Evaluates feedback")
Rel(completion, models, "Persists feedback and completion snapshot")
Rel(evaluator, models, "Reads comparable workouts and feedback")
Rel(evaluator, comparison, "Filters no-op and load-increasing reductions")
Rel(completion, freshness, "Creates proposal with expiry and canonical baseline")
Rel(material_change, freshness, "Creates bounded replan proposal after source edit")
Rel(comparison, freshness, "Checks availability before generating comparisons")
Rel(proposals, freshness, "Validates under locks before acceptance")
Rel(freshness, models, "Captures or verifies relevant owner-scoped canonical inputs")
Rel(freshness, return_rules, "Uses the same comparable pre-break baseline for replan freshness")
Rel(controllers, proposals, "Accepts or rejects proposal")
Rel(proposals, comparison, "Revalidates complete target set and bounded prescriptions")
Rel(comparison, models, "Resolves owner-scoped source/targets and current FTP")
Rel(comparison, feedback_limits, "Calculates allowed proposed prescriptions")
Rel(feedback_limits, editor, "Previews canonical definitions and metrics")
Rel(feedback_limits, load_rules, "Rechecks ceilings and weekly growth cap")
Rel(feedback_limits, progression, "Clamps requested levels")
Rel(proposals, editor, "Saves exact accepted definition and automatic load references")
Rel(proposals, material_change, "Applies accepted material-change replan")
Rel(proposals, models, "Updates progression state and proposal")
Rel(controllers, schedule_changes, "Resolves misses, availability and time off")
Rel(schedule_changes, prescriber, "Re-prescribes affected future dates")
Rel(prescriber, plan_builder, "Rebuilds prescriptions through preview engine")
Rel(prescriber, return_rules, "Reads recent comparable baseline and calendar return stage")
Rel(plan_builder, engine, "Forecasts workout definitions and metrics")
Rel(prescriber, engine, "Recalculates return-to-training prescriptions; retains taper work factors and ceilings")
Rel(prescriber, materializer, "Materializes after replacement")
Rel(materializer, engine, "Generates canonical steps and metrics")
Rel(materializer, progression, "Applies saved global intensity bias")
Rel(materializer, load_rules, "Preserves ceilings and limits generated weekly load")
Rel(load_rules, models, "Reads plan context and automatic load references")
Rel(load_review, load_rules, "Uses comparable-week rules and automatic load references")
Rel(load_review, models, "Reads fixed canonical workouts and outline forecasts")
Rel(materializer, models, "Saves structures and profile choices")
Rel(prescriber, models, "Replaces affected planned workouts")
Rel(controllers, ftp, "Updates FTP")
Rel(ftp, engine, "Recalculates metrics from stored percentage steps")
Rel(ftp, models, "Stores FTP reading and updates future metrics")
Rel(editor, engine, "Regenerates canonical workout structure")
Rel(editor, models, "Replaces planned steps and metrics")
Rel(models, database, "Reads and writes", "SQL")

note bottom of proposals
  Accepted global intensity bias feeds later horizon generation.
  Per-family stored bias remains unimplemented.
  Seven-day expiry and relevant canonical-input freshness are enforced.
  Expired, stale, legacy or invalid proposals require dismissal;
  acceptance failure rolls back all edits and preserves the proposal.
end note

note bottom of evaluator
  Structured regular targets only: today through day 13.
  Struggled: nearby broad Intervals reduction.
  Failed: nearby intensity reduction, within two calendar days.
  Difficult easy rides lower existing ranges at fixed duration.
  Late feedback is blocked if the next scheduled workout is completed.
  Openers save feedback without progression adaptation.
end note

note bottom of material_change
  Dismissal leaves the rest of the plan unchanged.
  The block starts at max(today, source date), lasts at most 14 days,
  and ends no later than plan end; the source remains fixed.
end note

note bottom of schedule_changes
  AvailabilityChanger uses submitted slots for its affected range.
  TimeOffPlanner selects the effective template for each future date.
  Missed replan uses today's effective template for its whole block.
end note

note bottom of return_rules
  Return duration factors: 60 / 70 / 80 / 100%, minimum 30 minutes.
  First two main bands: 45-60% / 55-68% FTP.
  Third stage: level-1 Tempo on intensity days, Endurance otherwise.
  Final stage: scheduled subtype, one level below comparable baseline.
  Weekly progression resumes from that reduced level after the ramp.
  Holiday/Event/Other resume from the baseline without the reduction.
  Saved limits survive outline persistence and horizon generation.
end note

SHOW_LEGEND()
@enduml
