@startuml
!pragma layout smetana
' Scope and limitations: README.md
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title CycleFar — Web Application Component Diagram

LAYOUT_LEFT_RIGHT()

Person(rider, "Rider", "Creates and manages a cycling training plan, records workout feedback, and controls manual sync.")
System_Ext(intervals_icu, "Intervals.icu", "External training-calendar service that stores CycleFar-owned workout events.")
System_Ext(smtp, "SMTP provider", "Delivers setup and password-reset mail; live delivery remains unverified.")
ContainerDb_Ext(database, "PostgreSQL database", "PostgreSQL", "Stores CycleFar's persistent data.")

Container_Boundary(web_application, "CycleFar web application") {
  Component(controllers, "Rails controllers", "Ruby on Rails", "Handle authenticated requests for settings, plans, workouts, adaptations, availability, time off and sync.")
  Component(authentication, "Authentication concern and account controllers", "Rails authentication", "Require a signed session for private requests; register, sign in/out and handle password reset.")
  Component(auth_models, "User, Session and Current", "Active Record / CurrentAttributes", "Store password digests and login sessions; expose the owner for training requests.")
  Component(account_access, "Accounts::Provision and operator task", "Service / Rake", "Creates a rider with a random password and sends a setup link behind a release flag.")
  Component(password_mailer, "PasswordsMailer", "Action Mailer", "Builds setup and reset emails using configured sender and delivery.")
  Component(views, "Views and CalendarHelper", "ERB, Turbo, Tailwind CSS / daisyUI", "Render canonical main-set summaries, current/frozen watt ranges, TSS/IF/work, outline purpose, event details, SVG profiles, weekly TSS chart and read-only comparisons.")
  Component(calendar, "Calendar presenter", "Planning::CalendarPresenter", "Builds the continuous calendar using persisted workouts and the same RecoverySchedule as previews and load checks.")
  Component(load_review, "WeeklyLoadReview", "Planning service", "Reads fixed workouts and outline forecasts to report infeasible load growth, including weeks beyond the detail horizon.")
  Component(plan_management, "Plan management services", "Planning services", "Preview/create and re-prescribe plans with aligned recovery and staged taper budgets; materialise saved choices with accepted bias and load limits.")
  Component(workouts, "Workout services", "Workouts and Metrics services", "Generate canonical workout steps with saved endurance-profile choices, calculate metrics, add/copy/edit/move workouts and build graph profiles.")
  Component(adaptations, "Adaptation and schedule services", "Adaptations and Planning services", "Record completion; validate, compare and apply proposals; save bias; resolve schedule/FTP changes and staged return limits from recent comparable training.")
  Component(settings, "Settings service", "Settings::Update", "Updates rider settings and FTP history atomically.")
  Component(sync, "Intervals.icu sync service", "IntervalsIcu::SyncNextTwo and WorkoutSerializer", "Retains owned identities before uploading up to two eligible workouts; removes every tracked event outside that set, preserving retry metadata and completed history.")
  Component(client, "Intervals.icu API client", "IntervalsIcu::Client", "Performs authenticated HTTP requests, timeouts, JSON handling and API-error mapping.")
  Component(models, "Domain models", "Active Record", "Enforce domain validations and persistence invariants for plans, workouts, steps, feedback, adaptations, settings and sync records.")
}

Rel(rider, controllers, "Uses CycleFar", "HTTPS")
Rel(rider, authentication, "Registers, signs in/out or requests a password reset", "HTTPS")
Rel(controllers, authentication, "Require authentication before training actions")
Rel(authentication, auth_models, "Validates credentials and creates/destroys sessions")
Rel(authentication, password_mailer, "Queues reset email")
Rel(account_access, auth_models, "Creates account")
Rel(account_access, password_mailer, "Sends setup link immediately")
Rel(password_mailer, smtp, "Delivers mail", "SMTP / STARTTLS")
Rel(auth_models, database, "Persists users and sessions", "SQL")
Rel(controllers, calendar, "Builds calendar views")
Rel(controllers, load_review, "Reviews load after horizon materialisation")
Rel(controllers, plan_management, "Previews/creates plans; materializes horizon on home load")
Rel(controllers, workouts, "Views and changes workouts")
Rel(controllers, adaptations, "Records feedback/schedule changes and builds owned proposal comparisons")
Rel(controllers, settings, "Updates settings")
Rel(controllers, sync, "Starts manual sync")
Rel(controllers, views, "Renders pages with presenter data")
Rel(views, workouts, "Builds graph data through ProfileBuilder")
Rel_D(controllers, models, "Loads owned records; archives/deletes plans")
Rel(controllers, auth_models, "Scopes profile, plan and record queries to Current.user")
Rel(calendar, models, "Reads calendar data")
Rel(load_review, models, "Reads prescriptions and saved automatic-load references without mutations")
Rel(plan_management, workouts, "Generates workout structures and metrics")
Rel(plan_management, models, "Creates and updates plans")
Rel(workouts, models, "Reads and updates planned workouts")
Rel(adaptations, plan_management, "Re-prescribes future training; shares load context and cap")
Rel(adaptations, models, "Records completions and schedule changes")
Rel(settings, adaptations, "Recalculates future metrics after FTP changes")
Rel(adaptations, workouts, "Applies accepted edits and calculates FTP metrics")
Rel(settings, models, "Updates rider profile and FTP readings")
Rel(sync, models, "Selects owner-scoped workouts and updates owner-scoped sync records")
Rel(sync, client, "Sends serialized events")
Rel(client, intervals_icu, "Upserts and deletes CycleFar-owned events", "HTTPS / JSON")
Rel(models, database, "Reads and writes", "SQL")

note bottom of models
  Required ownership and per-user profile/active-plan uniqueness
  are enforced by database constraints as well as model validation.
  PostgreSQL triggers protect completed workouts, steps and feedback
  against updates/deletes, including direct SQL writes.
end note

SHOW_LEGEND()
@enduml
