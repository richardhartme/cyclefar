@startuml CycleFar Component Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title CycleFar — Web Application Component Diagram

LAYOUT_LEFT_RIGHT()

Person(rider, "Rider", "Creates and manages a cycling training plan, records workout feedback, and controls manual sync.")
System_Ext(intervals_icu, "Intervals.icu", "External training-calendar service that stores CycleFar-owned workout events.")
ContainerDb_Ext(database, "PostgreSQL database", "PostgreSQL", "Stores CycleFar's persistent data.")

Container_Boundary(web_application, "CycleFar web application") {
  Component(controllers, "Rails controllers", "Ruby on Rails", "Handle HTTP requests for settings, plan creation, calendar actions, completions, adaptations, time off, availability and sync.")
  Component(calendar, "Calendar presenter", "Planning::CalendarPresenter", "Builds the continuous calendar view from plans, workouts, phases and time off.")
  Component(plan_management, "Plan management services", "Planning services", "Validate configurations, build previews, create plans, prescribe future workouts and materialise the structured-workout horizon.")
  Component(workouts, "Workout services", "Workouts and Metrics services", "Generate deterministic canonical workout steps, calculate metrics, edit future workouts and build graph profiles.")
  Component(adaptations, "Adaptation and schedule services", "Adaptations and Planning services", "Record completion feedback, evaluate and apply proposals, resolve missed workouts, change availability, manage time off and recalculate future FTP targets.")
  Component(settings, "Settings service", "Settings::Update", "Updates rider settings and FTP history atomically.")
  Component(sync, "Intervals.icu sync service", "IntervalsIcu::SyncNextTwo and WorkoutSerializer", "Selects and serializes the next two eligible structured workouts and reconciles CycleFar-owned sync records.")
  Component(client, "Intervals.icu API client", "IntervalsIcu::Client", "Performs authenticated HTTP requests, timeouts, JSON handling and API-error mapping.")
  ComponentDb(models, "Domain models", "Active Record", "Enforce domain validations and persistence invariants for plans, workouts, steps, feedback, adaptations, settings and sync records.")
}

Rel(rider, controllers, "Uses CycleFar", "HTTPS")
Rel(controllers, calendar, "Builds calendar views")
Rel(controllers, plan_management, "Creates and changes plans")
Rel(controllers, workouts, "Views and changes workouts")
Rel(controllers, adaptations, "Records feedback and schedule changes")
Rel(controllers, settings, "Updates settings")
Rel(controllers, sync, "Starts manual sync")
Rel(calendar, workouts, "Builds workout graph profiles")
Rel(calendar, models, "Reads calendar data")
Rel(plan_management, workouts, "Generates workout structures and metrics")
Rel(plan_management, models, "Creates and updates plans")
Rel(workouts, models, "Reads and updates future workouts")
Rel(adaptations, plan_management, "Re-prescribes affected future training")
Rel(adaptations, models, "Records completions and schedule changes")
Rel(settings, models, "Updates rider profile and FTP readings")
Rel(sync, models, "Selects workouts and updates sync records")
Rel(sync, client, "Sends serialized events")
Rel(client, intervals_icu, "Upserts and deletes CycleFar-owned events", "HTTPS / JSON")
Rel(models, database, "Reads and writes", "SQL")

SHOW_LEGEND()
@enduml
