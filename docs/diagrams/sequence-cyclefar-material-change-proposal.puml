@startuml
title CycleFar — Optional replan after Change Workout

autonumber
hide footbox

actor Rider
boundary "PlannedWorkoutsController" as WorkoutController
control "ManualEditor" as Editor
control "MaterialChangeProposal" as ProposalService
control "ProposalCreator +\nProposalFreshness" as Freshness
boundary "AdaptationProposalsController" as ProposalController
control "ProposalApplier" as Applier
control "MaterialChangeReplanner" as Replanner
control "FuturePrescriber" as Prescriber
control "HorizonMaterializer" as Materializer
control "LoadContext, WeeklyLoadCap\nand LoadReduction" as LoadRules
database "PostgreSQL" as Database

== The rider's selected workout changes immediately ==
Rider -> WorkoutController: POST Change Workout with type and duration
WorkoutController -> Database: load rider-owned planned structured workout
group transaction under owned plan lock
  WorkoutController -> Database: lock plan
  WorkoutController -> Editor: apply!(change)
  Editor -> Database: save replacement canonical steps and current-FTP metrics
  Editor --> WorkoutController: material change flag
  WorkoutController -> ProposalService: replace!(material_change flag)
  ProposalService -> Database: remove older material-change proposal for this workout
  opt material change
    ProposalService -> Freshness: ProposalCreator.create!(bounded replan payload)
    Freshness -> Database: capture canonical digest after the source edit
    Freshness -> Database: save optional proposal with seven-day expiry
  end
end
WorkoutController --> Rider: redirect to workout detail

== Review availability of the separate optional replan ==
Rider -> WorkoutController: GET workout detail
WorkoutController -> Database: load source and its optional material-change proposal
opt proposal exists
  WorkoutController -> Freshness: check expiry, active plan, source and canonical digest
  Freshness -> Database: read relevant canonical inputs and schedule
  Freshness --> WorkoutController: available or dismissal guidance
  WorkoutController --> Rider: show Accept / Reject if available; Reject only otherwise
end

== The rest of the plan waits for a separate decision ==
opt material-change proposal exists
  alt keep rest of plan unchanged or dismiss unavailable proposal
    Rider -> ProposalController: DELETE proposal
    ProposalController -> Database: load rider-owned proposal
    ProposalController -> Applier: reject!
    Applier -> Database: lock plan, then proposal; destroy proposal
  else replan upcoming workouts
    Rider -> ProposalController: POST accept proposal
    ProposalController -> Database: load rider-owned proposal
    ProposalController -> Applier: accept!
    group acceptance transaction: lock plan, then proposal
      Applier -> Database: lock owned plan and proposal
      Applier -> Freshness: validate expiry, active plan and canonical digest
      Freshness -> Database: read relevant canonical inputs and source
      alt expired, stale, legacy or invalid proposal
        Applier --> ProposalController: error; preserve source, future workouts and proposal
      else valid proposal
        Applier -> Replanner: apply!
        Replanner -> Database: validate planned structured source and bounded dates
        Replanner -> Database: read effective availability template for each date
        loop each template's dates in bounded block
          Replanner -> Prescriber: replace!(dates, preserve source workout ID)
          Prescriber -> Database: replace other eligible future planned prescriptions
          Prescriber -> Materializer: structure near-term outlines
          Materializer -> LoadRules: preserve ceilings and recheck actual weekly load
          Materializer -> Database: save new canonical steps and generation choices
        end
        Applier -> Database: destroy proposal
      end
    end
  end
  ProposalController --> Rider: redirect to calendar with result
end

note over Replanner, Database
  The manually changed source remains fixed even when the proposal is rejected
  or acceptance fails. The replan starts at max(today, source date), spans at most
  14 days and is bounded by plan end. Each date uses its effective template.
  Completed/missed history, phase dates and event remain unchanged.
  Any failure rolls back all acceptance-time edits.
end note
@enduml
