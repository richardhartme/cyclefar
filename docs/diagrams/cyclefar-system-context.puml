@startuml CycleFar System Context
' Ownership and account access checked on 2026-09-28; scope and limitations: README.md
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title CycleFar — System Context

LAYOUT_LEFT_RIGHT()

Person(rider, "Rider", "Creates and manages a cycling training plan, records workout feedback, and controls manual sync.")

System(cyclefar, "CycleFar", "A cycling training planner with public registration and private user-owned profiles, plans and sync records.")

System_Ext(intervals_icu, "Intervals.icu", "External training-calendar service that stores CycleFar-owned workout events.")

Rel(rider, cyclefar, "Registers or signs in; creates and manages plans; completes workouts; reviews adaptations", "Web browser")
Rel(cyclefar, intervals_icu, "Manually exports up to two upcoming executable structured workouts; reconciles tracked CycleFar-owned events", "HTTPS / JSON")

note bottom of cyclefar
  Automated two-rider isolation coverage exists.
  Target-data migration rehearsal, live SMTP delivery
  and Milestone 11 acceptance remain open.
end note

SHOW_LEGEND()
@enduml
