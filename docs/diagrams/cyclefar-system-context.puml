@startuml CycleFar System Context
' Authentication updated against application source on 2026-09-27; scope and limitations: README.md
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title CycleFar — System Context

LAYOUT_LEFT_RIGHT()

Person(rider, "Rider", "Creates and manages a cycling training plan, records workout feedback, and controls manual sync.")

System(cyclefar, "CycleFar", "A local, single-rider cycling training planner with generated sign-in and password-reset flows. Training data remains shared singleton data.")

System_Ext(intervals_icu, "Intervals.icu", "External training-calendar service that stores CycleFar-owned workout events.")

Rel(rider, cyclefar, "Signs in; creates and manages plans; completes workouts; reviews adaptations", "Web browser")
Rel(cyclefar, intervals_icu, "Manually exports up to two upcoming executable structured workouts; reconciles tracked CycleFar-owned events", "HTTPS / JSON")

SHOW_LEGEND()
@enduml
