@startuml
!pragma layout smetana
' Scope and limitations: README.md
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title CycleFar — Intervals.icu Sync Components

LAYOUT_LEFT_RIGHT()

Person(rider, "Rider", "Starts an explicit manual sync from the CycleFar calendar.")
System_Ext(intervals_icu, "Intervals.icu", "External training-calendar service that stores CycleFar-owned workout events.")
ContainerDb_Ext(database, "PostgreSQL database", "PostgreSQL", "Stores CycleFar's plans, workouts, settings and sync records.")

Container_Boundary(web_application, "CycleFar web application") {
  Component(controller, "IntervalsIcuSyncsController", "Ruby on Rails controller", "Uses the signed-in rider's active plan and profile; displays outcome without exposing the API key.")
  Component(sync, "SyncNextTwo", "IntervalsIcu service", "Checks plan/profile ownership; selects up to two eligible workouts and reconciles only this owner's tracked events.")
  Component(serializer, "WorkoutSerializer", "IntervalsIcu service", "Exports flat canonical percentage steps, ramp midpoints, current FTP and stored estimated metrics into event payloads.")
  Component(client, "Client", "IntervalsIcu HTTP client", "Uses API-key Basic auth, five-second connect/read timeouts and one transient retry; parses JSON and maps errors.")
  Component(models, "User, plan, profile, workout and sync models", "Active Record", "Provides canonical steps and encrypted rider key; sync records retain required user_id after workout deletion.")
}

Rel(rider, controller, "Starts manual sync", "HTTPS")
Rel(controller, sync, "Synchronizes active plan")
Rel(sync, models, "Selects eligible workouts and this rider's linked/detached sync records")
Rel(sync, serializer, "Builds event payloads")
Rel(serializer, models, "Reads canonical steps and current FTP context")
Rel(sync, client, "Bulk-upserts desired set, then bulk-deletes stale external IDs")
Rel(client, intervals_icu, "Sends authenticated bulk event requests", "HTTPS / JSON")
Rel(sync, models, "Transactionally saves IDs, digests and timestamps after remote success")
Rel(models, database, "Reads and writes", "SQL")

note bottom of sync
  Stable external IDs: cyclefar-workout-<id>.
  Cleanup covers detached records and linked planned
  future workouts outside the selected set. Linked
  missed/completed/past workouts are not yet cleaned up.
  No remote listing, automatic sync or activity import.
  Remote calls and local persistence are separate transactions;
  failed cleanup retains metadata for an idempotent retry.
end note

SHOW_LEGEND()
@enduml
