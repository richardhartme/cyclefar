<section class="max-w-xl rounded-lg border border-slate-200 bg-white p-6">
  <%= link_to "Back to calendar", root_path, class: "font-semibold text-teal-800 underline" %>
  <h1 class="mt-5 text-3xl font-semibold">Add time off</h1>
  <p class="mt-2 text-slate-600">Workouts during this period will be removed. Illness and recovery need an easier return period.</p>

  <%= form_with model: TimeOffPeriod.new, class: "mt-6 space-y-4" do |form| %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :starts_on, "Start date", class: "block font-semibold" %>
        <%= form.date_field :starts_on, value: Date.current, min: @plan.starts_on, max: @plan.ends_on, class: "mt-1 w-full rounded border-slate-300" %>
      </div>
      <div>
        <%= form.label :ends_on, "End date", class: "block font-semibold" %>
        <%= form.date_field :ends_on, value: Date.current, min: @plan.starts_on, max: @plan.ends_on, class: "mt-1 w-full rounded border-slate-300" %>
      </div>
    </div>
    <div>
      <%= form.label :reason, class: "block font-semibold" %>
      <%= form.select :reason, TimeOffPeriod.reasons.keys.map { |reason| [reason.humanize, reason] }, {}, class: "mt-1 w-full rounded border-slate-300" %>
    </div>
    <div>
      <%= form.label :name, "Name (optional)", class: "block font-semibold" %>
      <%= form.text_field :name, placeholder: "e.g. France", class: "mt-1 w-full rounded border-slate-300" %>
    </div>
    <div>
      <%= form.label :return_ramp_days, "Easier return days (illness/recovery only)", class: "block font-semibold" %>
      <%= form.number_field :return_ramp_days, min: 1, class: "mt-1 w-full rounded border-slate-300" %>
    </div>
    <%= form.submit "Add time off", class: "rounded bg-teal-800 px-4 py-2 font-semibold text-white" %>
  <% end %>
</section>
