<section class="card bg-base-100 mx-auto max-w-2xl shadow-sm">
  <div class="card-body gap-6">
    <div>
      <%= link_to "← Back to calendar", root_path, class: "link link-primary font-semibold" %>
      <h1 class="card-title mt-5 text-3xl">Add time off</h1>
      <p class="text-base-content/70 mt-2">Block out dates when you will not be training and adjust your return where needed.</p>
    </div>

    <div role="note" class="alert alert-warning alert-soft">
      <span>Workouts during this period will be removed. Illness and recovery need an easier return period.</span>
    </div>

    <%= form_with model: TimeOffPeriod.new, class: "space-y-6" do |form| %>
      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-4">
        <legend class="fieldset-legend px-2 text-base">Time-off period</legend>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :starts_on, "Start date", class: "label font-semibold" %>
            <%= form.date_field :starts_on, value: Date.current, min: @plan.starts_on, max: @plan.ends_on, class: "input w-full" %>
          </div>
          <div>
            <%= form.label :ends_on, "End date", class: "label font-semibold" %>
            <%= form.date_field :ends_on, value: Date.current, min: @plan.starts_on, max: @plan.ends_on, class: "input w-full" %>
          </div>
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="fieldset-legend text-base">Details</legend>
        <%= form.label :reason, class: "label font-semibold" %>
        <%= form.select :reason, TimeOffPeriod.reasons.keys.map { |reason| [reason.humanize, reason] }, {}, class: "select w-full" %>

        <%= form.label :name, "Name (optional)", class: "label mt-2 font-semibold" %>
        <%= form.text_field :name, placeholder: "e.g. France", class: "input w-full" %>
        <p class="label text-base-content/60">Add a short label to make this period easy to recognise on your calendar.</p>
      </fieldset>

      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-4">
        <legend class="fieldset-legend px-2 text-base">Return to training</legend>
        <%= form.label :return_ramp_days, "Easier return days (illness/recovery only)", class: "label font-semibold" %>
        <%= form.number_field :return_ramp_days, min: 1, class: "input w-full", placeholder: "Number of days" %>
        <p class="label text-base-content/60">Leave blank for Holiday, Event, or Other.</p>
      </fieldset>

      <div class="card-actions justify-end">
        <%= link_to "Cancel", root_path, class: "btn btn-ghost" %>
        <%= form.submit "Add time off", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</section>
