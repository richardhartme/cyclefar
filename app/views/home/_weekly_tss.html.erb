<section class="mt-8 w-full rounded-lg border border-slate-200 bg-white p-4" aria-labelledby="weekly-tss-heading">
  <h2 id="weekly-tss-heading" class="text-lg font-semibold">Weekly training load</h2>
  <p class="mt-1 text-sm text-slate-600">TSS per week · week commencing Monday</p>
  <% maximum = [weeks.map(&:estimated_tss).max.to_f, 1].max %>
  <% ceiling = (maximum / 50.0).ceil * 50 %>
  <div class="mt-5 flex gap-2">
    <div class="flex h-48 w-12 shrink-0 flex-col justify-between text-right text-xs text-slate-500" aria-hidden="true">
      <span><%= ceiling %></span>
      <span><%= ceiling / 2 %></span>
      <span>0</span>
    </div>
    <div class="min-w-0 flex-1">
      <ol class="flex w-full" aria-label="Weekly TSS">
        <% weeks.each do |week| %>
          <% current_week = week.starts_on == Date.current.beginning_of_week %>
          <li class="min-w-0 flex-1" aria-label="Week of <%= week.starts_on.to_fs(:long) %>: <%= week.estimated_tss.round %> TSS" title="Week of <%= week.starts_on.to_fs(:long) %>: <%= week.estimated_tss.round %> TSS">
            <div class="flex h-48 items-end justify-center border-b border-slate-300">
              <div class="w-4/5 rounded-t <%= current_week ? 'bg-blue-300 hover:bg-blue-400' : 'bg-slate-400 hover:bg-slate-500' %>" style="height: <%= (week.estimated_tss / ceiling * 100).round(2) %>%"></div>
            </div>
          </li>
        <% end %>
      </ol>
    </div>
  </div>
</section>
