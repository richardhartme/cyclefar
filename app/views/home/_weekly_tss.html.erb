<section class="card bg-base-100 w-full shadow-sm" aria-labelledby="weekly-tss-heading">
  <div class="card-body">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 id="weekly-tss-heading" class="card-title">Weekly training load</h2>
        <p class="text-base-content/60 mt-1 text-sm">TSS per week · week commencing Monday</p>
      </div>
      <span class="badge badge-primary badge-outline">TSS</span>
    </div>
    <% maximum = [weeks.map(&:estimated_tss).max.to_f, 1].max %>
    <% ceiling = (maximum / 50.0).ceil * 50 %>
    <div class="mt-3 flex gap-2">
      <div class="text-base-content/50 flex h-48 w-12 shrink-0 flex-col justify-between text-right text-xs" aria-hidden="true">
        <span><%= ceiling %></span>
        <span><%= ceiling / 2 %></span>
        <span>0</span>
      </div>
      <div class="min-w-0 flex-1">
        <ol class="flex w-full" aria-label="Weekly TSS">
          <% weeks.each do |week| %>
            <% current_week = week.starts_on == Date.current.beginning_of_week %>
            <li class="min-w-0 flex-1" aria-label="Week of <%= week.starts_on.to_fs(:long) %>: <%= week.estimated_tss.round %> TSS" title="Week of <%= week.starts_on.to_fs(:long) %>: <%= week.estimated_tss.round %> TSS">
              <div class="border-base-300 flex h-48 items-end justify-center border-b">
                <div class="w-4/5 rounded-t transition-colors <%= current_week ? 'bg-secondary hover:bg-secondary/80' : 'bg-primary hover:bg-primary/80' %>" style="height: <%= (week.estimated_tss / ceiling * 100).round(2) %>%"></div>
              </div>
            </li>
          <% end %>
        </ol>
      </div>
    </div>
  </div>
</section>
