<% unless @plan %>
<section class="max-w-2xl rounded-xl border border-slate-200 bg-white p-10">
  <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-teal-700">CycleFar</p>
  <h1 class="mb-4 text-3xl font-semibold">Training that fits your week.</h1>
  <p class="mb-8 text-lg text-slate-600">Plan your indoor cycling around your goals and the time you have to ride.</p>
  <%= link_to "Create training plan", new_training_plan_path, class: "inline-block rounded-lg bg-teal-800 px-5 py-3 font-semibold text-white hover:bg-teal-900" %>
  <p class="mt-6 text-slate-600"><%= link_to "Set your FTP in Settings", settings_path, class: "underline" %></p>
</section>
<% else %>
<section>
  <h1 class="text-3xl font-semibold">Training calendar</h1>
  <p class="mt-2 text-slate-600"><%= @plan.goal.humanize %> · <%= @plan.discipline.humanize %> · <%= @plan.starts_on.to_fs(:long) %> – <%= @plan.ends_on.to_fs(:long) %></p>
  <% @calendar.weeks.each do |week| %>
    <section class="mt-8 overflow-x-auto rounded-lg border border-slate-200 bg-white" aria-label="Week of <%= week.starts_on.to_fs(:long) %>">
      <header class="flex items-center justify-between border-b p-4 <%= week.recovery_week ? "bg-teal-50" : "bg-slate-50" %>"><strong><%= week.starts_on.to_fs(:long) %> · <%= week.phase_label %><%= " · Recovery week" if week.recovery_week %></strong><span><%= week.duration_minutes %> min · <%= week.estimated_tss.round %> TSS · <%= week.estimated_work_kj.round %> kJ</span></header>
      <div class="grid min-w-[840px] grid-cols-7 divide-x"><% week.days.each_with_index do |date, index| %><div class="min-h-48 p-3"><strong><%= date.strftime("%a %-d") %></strong><% if date.day == 1 || index.zero? %><p class="text-xs font-semibold uppercase text-teal-700"><%= date.strftime("%B") %></p><% end %><% if (event = @calendar.event_on(date)) %><article class="mt-3 rounded bg-amber-100 p-2"><strong><%= event.name %></strong><br><span class="text-sm">Target event · <%= event.discipline.humanize %></span></article><% end %><% @calendar.workouts_on(date).each do |workout| %><article class="mt-3 rounded border p-2"><% if workout.ftp_test? %><strong>FTP Test</strong><p class="text-sm">Use your preferred assessment, then update Settings.</p><% elsif workout.structured? %><strong><%= workout.name %></strong><p class="text-sm"><%= workout.duration_minutes %> min · <%= workout.estimated_tss.round %> TSS · IF <%= format("%.2f", workout.estimated_if) %></p><%= workout_profile_svg(workout) %><% else %><strong><%= workout.name %></strong><p class="text-sm"><%= workout.duration_minutes %> min · <%= workout.plan_phase.kind.humanize %></p><% end %></article><% end %></div><% end %></div>
    </section>
  <% end %>
</section>
<% end %>
