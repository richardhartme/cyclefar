<section>
  <% if @plan %>
    <h1 class="text-3xl font-semibold">Training calendar</h1>
    <p class="mt-2 text-slate-600"><%= @plan.goal.humanize %> · <%= @plan.discipline.humanize %> · <%= @plan.starts_on.to_fs(:long) %> – <%= @plan.ends_on.to_fs(:long) %></p>
    <% last_intervals_sync = @plan.planned_workouts.joins(:intervals_icu_sync).maximum("intervals_icu_syncs.last_synced_at") %>
    <div class="mt-3 flex flex-wrap items-center gap-4">
      <%= link_to "Change availability", new_availability_change_path, class: "font-semibold text-blue-800 underline" %>
      <%= link_to "Add time off", new_time_off_period_path, class: "font-semibold text-blue-800 underline" %>
      <%= button_to "Sync next 2 to Intervals.icu", intervals_icu_sync_path, class: "cursor-pointer font-semibold text-blue-800 underline transition-colors enabled:hover:text-blue-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:cursor-not-allowed disabled:opacity-50" %>
      <%= button_to(
        @has_completed_workouts ? "Archive plan" : "Delete plan",
        training_plan_path,
        method: :delete,
        form: { data: { turbo_confirm: @has_completed_workouts ? "Archive this plan? Completed workouts will remain available in the archived plan." : "Delete this plan and all of its planned workouts?" } },
        class: "cursor-pointer font-semibold text-red-700 underline transition-colors enabled:hover:text-red-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700 disabled:cursor-not-allowed disabled:opacity-50") %>
    </div>
    <% if last_intervals_sync %>
      <p class="mt-2 text-sm text-slate-600">Last synced to Intervals.icu <%= time_ago_in_words(last_intervals_sync) %> ago.</p>
    <% end %>

    <% @plan.adaptation_proposals.each do |proposal| %>
      <section class="mt-5 rounded-lg border border-amber-300 bg-amber-50 p-4">
        <strong>Adaptation proposal</strong>
        <p><%= proposal.reason %></p>
        <div class="mt-2 flex gap-3">
          <%= button_to "Accept all", accept_adaptation_proposal_path(proposal), class: "rounded bg-blue-800 px-3 py-2 text-white" %>
          <%= button_to "Reject all", reject_adaptation_proposal_path(proposal), method: :delete, form: { data: { turbo_confirm: "Reject this adaptation proposal?" } }, class: "rounded border px-3 py-2" %>
        </div>
      </section>
    <% end %>
  <% else %>
    <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-blue-700">CycleFar</p>
    <h1 class="text-3xl font-semibold">Training calendar</h1>
    <p class="mt-2 text-lg text-slate-600">Create a training plan to add structured workouts to your calendar.</p>
    <div class="mt-5 flex flex-wrap items-center gap-4">
      <%= link_to "Create training plan", new_training_plan_path, class: "inline-block rounded-lg bg-blue-800 px-5 py-3 font-semibold text-white hover:bg-blue-900" %>
      <%= link_to "Set your FTP in Settings", settings_path, class: "text-slate-600 underline" %>
    </div>
  <% end %>

  <% weeks = @calendar.weeks %>
  <%= render "weekly_tss", weeks: weeks if @plan %>

  <div class="mt-8 overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <% weeks.each do |week| %>
      <section class="grid min-w-[840px] divide-x border-b border-slate-200 last:border-b-0" style="grid-template-columns: repeat(7, minmax(120px, 1fr))<%= " 11rem" if @plan %>" aria-label="Week of <%= week.starts_on.to_fs(:long) %>">
          <% week.days.each do |date| %>
            <div class="min-h-48 p-3">
              <% can_add_workout = @plan && @calendar.workouts_on(date).empty? && !@calendar.event_on(date) && !@calendar.time_off_on(date) %>
              <strong>
                <% if can_add_workout %>
                  <%= link_to date.strftime("%a %-d"), new_planned_workout_path(scheduled_on: date), class: "text-blue-800 underline", aria: { label: "Add workout on #{date.to_fs(:long)}" } %>
                <% else %>
                  <%= date.strftime("%a %-d") %>
                <% end %>
              </strong>
              <% if date.day == 1 %>
                <p class="text-xs font-semibold uppercase text-blue-700"><%= date.strftime("%B") %></p>
              <% end %>

              <% if (event = @calendar.event_on(date)) %>
                <article class="mt-3 rounded bg-amber-100 p-2">
                  <strong><%= event.name %></strong><br>
                  <span class="text-sm">Target event · <%= event.discipline.humanize %></span>
                </article>
              <% end %>

              <% if (time_off = @calendar.time_off_on(date)) %>
                <article class="mt-3 rounded bg-slate-200 p-2">
                  <strong><%= time_off.name.presence || (time_off.event? ? "Time off" : time_off.reason.humanize) %></strong>
                  <% if time_off.name.present? && !time_off.event? %>
                    <p class="text-sm"><%= time_off.reason.humanize %></p>
                  <% end %>
                  <%= button_to "Remove", time_off_period_path(time_off), method: :delete, form: { data: { turbo_confirm: "Remove this time-off period and restore its future training?" } }, class: "mt-1 text-sm underline" %>
                </article>
              <% end %>

              <% @calendar.workouts_on(date).each do |workout| %>
                <article class="mt-3 rounded border border-l-4 p-2 <%= workout_card_colors(workout) %>">
                  <div class="<%= "opacity-50 grayscale" if workout.missed? %>">
                    <% if workout.ftp_test? %>
                      <strong><%= link_to "FTP Test", planned_workout_path(workout), class: "underline" %></strong>
                      <p class="text-sm">Use your preferred assessment, then update Settings.</p>
                    <% elsif workout.structured? %>
                      <strong><%= link_to workout.name, planned_workout_path(workout), class: "underline" %></strong>
                      <p class="text-sm"><%= workout.duration_minutes %> min · <%= workout.estimated_tss.round %> TSS · IF <%= format("%.2f", workout.estimated_if) %></p>
                      <%= workout_profile_svg(workout) %>
                    <% else %>
                      <strong><%= link_to workout.name, planned_workout_path(workout), class: "underline" %></strong>
                      <p class="text-sm"><%= workout.duration_minutes %> min · <%= workout.plan_phase.kind.humanize %></p>
                    <% end %>
                  </div>

                  <% if workout.completed? %>
                    <p class="mt-1 text-sm font-semibold text-blue-800">Completed</p>
                  <% elsif workout.missed? %>
                    <p class="mt-1 text-sm font-semibold text-slate-600">Missed</p>
                  <% elsif workout.scheduled_on < Date.current %>
                    <p class="mt-1 text-sm font-semibold text-amber-700">Awaiting status</p>
                  <% end %>
                </article>
              <% end %>
            </div>
          <% end %>

        <% if @plan %>
          <aside class="p-4 <%= week.recovery_week ? "bg-blue-50" : "bg-slate-50" %>" aria-label="Weekly summary for <%= week.starts_on.to_fs(:long) %>">
            <strong class="block"><%= week.starts_on.to_fs(:long) %></strong>
            <p class="mt-1 text-sm font-semibold text-blue-800"><%= week.phase_label %><%= " · Recovery week" if week.recovery_week %></p>
            <dl class="mt-5 space-y-3 text-sm">
              <div>
                <dt class="text-slate-600">Duration</dt>
                <dd class="font-semibold"><%= week.duration_minutes %> min</dd>
              </div>
              <div>
                <dt class="text-slate-600">Load</dt>
                <dd class="font-semibold"><%= week.estimated_tss.round %> TSS</dd>
              </div>
              <div>
                <dt class="text-slate-600">Work</dt>
                <dd class="font-semibold"><%= week.estimated_work_kj.round %> kJ</dd>
              </div>
            </dl>
          </aside>
        <% end %>
      </section>
    <% end %>
  </div>
</section>
