<section class="space-y-8">
  <% if @plan %>
    <% last_intervals_sync = @plan.planned_workouts.joins(:intervals_icu_sync).maximum("intervals_icu_syncs.last_synced_at") %>
    <header class="card bg-base-100 shadow-sm">
      <div class="card-body gap-5 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h1 class="card-title text-3xl">Training calendar</h1>
          <div class="mt-3 flex flex-wrap gap-2">
            <span class="badge badge-primary"><%= @plan.goal.humanize %></span>
            <span class="badge badge-secondary"><%= @plan.discipline.humanize %></span>
            <span class="badge badge-ghost"><%= @plan.starts_on.to_fs(:long) %> – <%= @plan.ends_on.to_fs(:long) %></span>
          </div>
          <% if last_intervals_sync %>
            <p class="text-base-content/60 mt-3 text-sm">Last synced to Intervals.icu <%= time_ago_in_words(last_intervals_sync) %> ago.</p>
          <% end %>
        </div>

        <div class="card-actions items-center lg:max-w-xl lg:justify-end">
          <%= link_to "Change availability", new_availability_change_path, class: "btn btn-outline btn-primary btn-sm" %>
          <%= link_to "Add time off", new_time_off_period_path, class: "btn btn-outline btn-secondary btn-sm" %>
          <%= button_to "Sync next 2 to Intervals.icu", intervals_icu_sync_path, class: "btn btn-accent btn-sm" %>
          <%= button_to(
            @has_completed_workouts ? "Archive plan" : "Delete plan",
            training_plan_path,
            method: :delete,
            form: { data: { turbo_confirm: @has_completed_workouts ? "Archive this plan? Completed workouts will remain available in the archived plan." : "Delete this plan and all of its planned workouts?" } },
            class: "btn btn-error btn-outline btn-sm") %>
        </div>
      </div>
    </header>

    <% @plan.adaptation_proposals.each do |proposal| %>
      <section class="alert alert-warning items-start sm:items-center" aria-label="Adaptation proposal">
        <div>
          <strong class="block"><%= proposal.material_change_replan? ? "Optional upcoming replan" : "Adaptation proposal" %></strong>
          <p><%= proposal.reason %></p>
        </div>
        <div class="flex flex-wrap gap-2 sm:ml-auto">
          <%= button_to proposal.material_change_replan? ? "Replan upcoming workouts" : "Accept all", accept_adaptation_proposal_path(proposal), class: "btn btn-success btn-sm" %>
          <%= button_to proposal.material_change_replan? ? "Keep rest of plan unchanged" : "Reject all", reject_adaptation_proposal_path(proposal), method: :delete, form: { data: { turbo_confirm: proposal.material_change_replan? ? nil : "Reject this adaptation proposal?" } }, class: "btn btn-ghost btn-sm" %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="hero bg-base-100 rounded-box shadow-sm">
      <div class="hero-content py-12 text-center">
        <div class="max-w-xl">
          <h1 class="text-4xl font-bold">Training calendar</h1>
          <p class="text-base-content/70 py-5 text-lg">Create a training plan to add structured workouts to Intervals.icu.</p>
          <div class="flex flex-wrap justify-center gap-3">
            <%= link_to "Create training plan", new_training_plan_path, class: "btn btn-primary" %>
            <%= link_to "Set your FTP in Settings", settings_path, class: "btn btn-ghost" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <% weeks = @calendar.weeks %>
  <%= render "weekly_tss", weeks: weeks if @plan %>

  <div class="bg-base-100 border-base-300 overflow-x-auto rounded-box border shadow-sm">
    <% weeks.each do |week| %>
      <section class="divide-base-300 border-base-300 grid min-w-[840px] divide-x border-b last:border-b-0" style="grid-template-columns: repeat(7, minmax(120px, 1fr))<%= " 11rem" if @plan %>" aria-label="Week of <%= week.starts_on.to_fs(:long) %>">
          <% week.days.each do |date| %>
            <div class="hover:bg-base-200/50 min-h-48 p-3 transition-colors">
              <% can_add_workout = @plan && @calendar.workouts_on(date).empty? && !@calendar.event_on(date) && !@calendar.time_off_on(date) %>
              <strong>
                <% if can_add_workout %>
                  <%= link_to date.strftime("%a %-d"), new_planned_workout_path(scheduled_on: date), class: "link link-primary", aria: { label: "Add workout on #{date.to_fs(:long)}" } %>
                <% else %>
                  <%= date.strftime("%a %-d") %>
                <% end %>
              </strong>
              <% if date.day == 1 %>
                <p class="badge badge-primary badge-sm mt-1"><%= date.strftime("%B") %></p>
              <% end %>

              <% if (event = @calendar.event_on(date)) %>
                <article class="card bg-warning text-warning-content mt-3 shadow-sm">
                  <div class="card-body gap-1 p-3">
                    <strong><%= event.name %></strong>
                    <span class="text-sm">Target event · <%= event.discipline.humanize %></span>
                  </div>
                </article>
              <% end %>

              <% if (time_off = @calendar.time_off_on(date)) %>
                <article class="card bg-info text-info-content mt-3 shadow-sm">
                  <div class="card-body gap-1 p-3">
                    <strong><%= time_off.name.presence || (time_off.event? ? "Time off" : time_off.reason.humanize) %></strong>
                    <% if time_off.name.present? && !time_off.event? %>
                      <p class="text-sm"><%= time_off.reason.humanize %></p>
                    <% end %>
                    <div class="card-actions">
                      <%= button_to "Remove", time_off_period_path(time_off), method: :delete, form: { data: { turbo_confirm: "Remove this time-off period and restore its future training?" } }, class: "btn btn-xs border-base-300 bg-base-100 text-base-content shadow-none hover:bg-base-200" %>
                    </div>
                  </div>
                </article>
              <% end %>

              <% @calendar.workouts_on(date).each do |workout| %>
                <article class="card mt-3 border border-l-4 shadow-sm <%= workout_card_colors(workout) %>">
                  <div class="card-body gap-1 p-3">
                    <div class="<%= "opacity-50 grayscale" if workout.missed? %>">
                      <% if workout.ftp_test? %>
                        <strong><%= link_to "FTP Test", planned_workout_path(workout), class: "link" %></strong>
                        <p class="text-sm">Use your preferred assessment, then update Settings.</p>
                      <% elsif workout.structured? %>
                        <strong><%= link_to workout.name, planned_workout_path(workout), class: "link" %></strong>
                        <p class="text-sm"><%= workout.duration_minutes %> min · <%= workout.estimated_tss.round %> TSS · IF <%= format("%.2f", workout.estimated_if) %></p>
                        <%= workout_profile_svg(workout) %>
                      <% else %>
                        <strong><%= link_to workout.name, planned_workout_path(workout), class: "link" %></strong>
                        <p class="text-sm"><%= workout.duration_minutes %> min · <%= workout.plan_phase.kind.humanize %></p>
                      <% end %>
                    </div>

                    <% if workout.completed? %>
                      <p class="badge badge-success badge-sm mt-1">Completed</p>
                    <% elsif workout.missed? %>
                      <p class="badge badge-neutral badge-sm mt-1">Missed</p>
                    <% elsif workout.scheduled_on < Date.current %>
                      <p class="badge badge-warning badge-sm mt-1">Awaiting status</p>
                    <% end %>
                  </div>
                </article>
              <% end %>
            </div>
          <% end %>

        <% if @plan %>
          <aside class="p-4 <%= week.recovery_week ? "bg-info/15" : "bg-base-200" %>" aria-label="Weekly summary for <%= week.starts_on.to_fs(:long) %>">
            <strong class="block"><%= week.starts_on.to_fs(:long) %></strong>
            <p class="badge badge-primary badge-sm mt-2"><%= week.recovery_week ? "Recovery Week" : week.phase_label %></p>
            <dl class="stats stats-vertical mt-3 w-full bg-transparent shadow-none">
              <div class="stat px-0 py-2">
                <dt class="stat-title text-xs">Duration</dt>
                <dd class="stat-value text-base"><%= week.duration_minutes %> min</dd>
              </div>
              <div class="stat px-0 py-2">
                <dt class="stat-title text-xs">Load</dt>
                <dd class="stat-value text-base"><%= week.estimated_tss.round %> TSS</dd>
              </div>
              <div class="stat px-0 py-2">
                <dt class="stat-title text-xs">Work</dt>
                <dd class="stat-value text-base"><%= week.estimated_work_kj.round %> kJ</dd>
              </div>
            </dl>
          </aside>
        <% end %>
      </section>
    <% end %>
  </div>
</section>
