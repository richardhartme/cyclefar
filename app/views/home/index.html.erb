<% unless @plan %>
<section class="max-w-2xl rounded-xl border border-slate-200 bg-white p-10">
  <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-teal-700">CycleFar</p>
  <h1 class="mb-4 text-3xl font-semibold">Training that fits your week.</h1>
  <p class="mb-8 text-lg text-slate-600">Plan your indoor cycling around your goals and the time you have to ride.</p>
  <%= link_to "Create training plan", new_training_plan_path, class: "inline-block rounded-lg bg-teal-800 px-5 py-3 font-semibold text-white hover:bg-teal-900" %>
  <p class="mt-6 text-slate-600"><%= link_to "Set your FTP in Settings", settings_path, class: "underline" %></p>
</section>
<% else %>
<section>
  <h1 class="text-3xl font-semibold">Training calendar</h1>
  <p class="mt-2 text-slate-600"><%= @plan.goal.humanize %> · <%= @plan.discipline.humanize %> · <%= @plan.starts_on.to_fs(:long) %> – <%= @plan.ends_on.to_fs(:long) %></p>
  <% last_intervals_sync = @plan.planned_workouts.joins(:intervals_icu_sync).maximum("intervals_icu_syncs.last_synced_at") %>
  <div class="mt-3 flex flex-wrap items-center gap-4"><%= link_to "Change availability", new_availability_change_path, class: "font-semibold text-teal-800 underline" %><%= link_to "Add time off", new_time_off_period_path, class: "font-semibold text-teal-800 underline" %><%= button_to "Sync next 2 to Intervals.icu", intervals_icu_sync_path, class: "font-semibold text-teal-800 underline" %></div>
  <% if last_intervals_sync %><p class="mt-2 text-sm text-slate-600">Last synced to Intervals.icu <%= time_ago_in_words(last_intervals_sync) %> ago.</p><% end %>
  <% @plan.adaptation_proposals.each do |proposal| %><section class="mt-5 rounded-lg border border-amber-300 bg-amber-50 p-4"><strong>Adaptation proposal</strong><p><%= proposal.reason %></p><div class="mt-2 flex gap-3"><%= button_to "Accept all", accept_adaptation_proposal_path(proposal), class: "rounded bg-teal-800 px-3 py-2 text-white" %><%= button_to "Reject all", reject_adaptation_proposal_path(proposal), method: :delete, class: "rounded border px-3 py-2" %></div></section><% end %>
  <% @calendar.weeks.each do |week| %>
    <section class="mt-8 overflow-x-auto rounded-lg border border-slate-200 bg-white" aria-label="Week of <%= week.starts_on.to_fs(:long) %>">
      <header class="flex items-center justify-between border-b p-4 <%= week.recovery_week ? "bg-teal-50" : "bg-slate-50" %>"><strong><%= week.starts_on.to_fs(:long) %> · <%= week.phase_label %><%= " · Recovery week" if week.recovery_week %></strong><span><%= week.duration_minutes %> min · <%= week.estimated_tss.round %> TSS · <%= week.estimated_work_kj.round %> kJ</span></header>
      <div class="grid min-w-[840px] grid-cols-7 divide-x"><% week.days.each_with_index do |date, index| %><div class="min-h-48 p-3"><strong><%= date.strftime("%a %-d") %></strong><% if date.day == 1 || index.zero? %><p class="text-xs font-semibold uppercase text-teal-700"><%= date.strftime("%B") %></p><% end %><% if (event = @calendar.event_on(date)) %><article class="mt-3 rounded bg-amber-100 p-2"><strong><%= event.name %></strong><br><span class="text-sm">Target event · <%= event.discipline.humanize %></span></article><% end %><% if (time_off = @calendar.time_off_on(date)) %><article class="mt-3 rounded bg-slate-200 p-2"><strong>Time off</strong><p class="text-sm"><%= time_off.reason.humanize %></p><%= button_to "Remove", time_off_period_path(time_off), method: :delete, class: "mt-1 text-sm underline" %></article><% end %><% @calendar.workouts_on(date).each do |workout| %><article class="mt-3 rounded border p-2"><% if workout.ftp_test? %><strong>FTP Test</strong><p class="text-sm">Use your preferred assessment, then update Settings.</p><% elsif workout.structured? %><strong><%= link_to workout.name, planned_workout_path(workout), data: { turbo_frame: "workout_detail" }, class: "underline" %></strong><p class="text-sm"><%= workout.duration_minutes %> min · <%= workout.estimated_tss.round %> TSS · IF <%= format("%.2f", workout.estimated_if) %></p><%= workout_profile_svg(workout) %><% else %><strong><%= workout.name %></strong><p class="text-sm"><%= workout.duration_minutes %> min · <%= workout.plan_phase.kind.humanize %></p><% end %><% if workout.completed? %><p class="mt-1 text-sm font-semibold text-teal-800">Completed</p><% elsif workout.scheduled_on < Date.current %><p class="mt-1 text-sm font-semibold text-amber-700">Awaiting status</p><% end %></article><% end %></div><% end %></div>
    </section>
  <% end %>
</section>
<%= turbo_frame_tag "workout_detail" %>
<% end %>
