<section class="hero bg-base-100 rounded-box shadow-sm">
  <div class="hero-content py-16 text-center">
    <div class="max-w-xl">
      <h1 class="text-4xl font-bold">Plan smart. Ride far.</h1>
      <p class="text-base-content/70 py-5 text-lg">Build a cycling training plan around your goals and available time.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <%= link_to "Sign In", new_session_path, class: "btn btn-primary" %>
        <%= link_to "Register", new_registration_path, class: "btn btn-outline btn-primary" %>
      </div>
    </div>
  </div>
</section>
