<%= turbo_frame_tag "activity_detail" do %>
  <% if turbo_frame_request? %>
    <dialog class="modal" aria-labelledby="activity-detail-title" data-controller="activity-dialog" data-action="close->activity-dialog#dismiss">
      <div class="modal-box max-w-2xl">
        <%= render "detail", activity: @activity %>
        <form method="dialog" class="modal-action">
          <button class="btn">Close</button>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button tabindex="-1">Close</button>
      </form>
    </dialog>
  <% else %>
    <section aria-labelledby="activity-detail-title" class="card bg-base-100 border-base-300 mx-auto w-full max-w-3xl border shadow-sm">
      <div class="card-body gap-6 p-6 sm:p-8">
        <%= link_to "Back to calendar", root_path, class: "link link-primary font-semibold", data: { turbo_frame: "_top" } %>
        <%= render "detail", activity: @activity %>
      </div>
    </section>
  <% end %>
<% end %>
