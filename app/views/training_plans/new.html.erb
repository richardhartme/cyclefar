<section class="card bg-base-100 mx-auto w-full max-w-5xl shadow-sm">
  <div class="card-body gap-8">
    <div>
      <%= link_to "← Back to dashboard", root_path, class: "link link-primary font-semibold" %>
      <h1 class="card-title mt-5 text-3xl">Create training plan</h1>
      <p class="text-base-content/70 mt-2">Set your goal, schedule and progression preferences, then review a generated plan before creating it.</p>
    </div>

    <% if @configuration.errors.any? %>
      <section aria-labelledby="configuration-errors" class="alert alert-error alert-soft items-start">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="mt-0.5 size-5 shrink-0" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.3 3.8 2.2 18a2 2 0 0 0 1.7 3h16.2a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0Z" />
        </svg>
        <div>
          <h2 id="configuration-errors" class="font-semibold">Please correct the plan configuration</h2>
          <ul class="mt-2 list-disc pl-5"><% @configuration.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
      </section>
    <% end %>

    <%= form_with url: preview_training_plan_path, scope: :plan_configuration, data: { turbo: false }, class: "space-y-6" do %>
      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-5">
        <legend class="fieldset-legend px-2 text-lg">Goal</legend>
        <div class="grid gap-3 sm:grid-cols-2">
          <% Planning::PreviewPresenter::GOAL_LABELS.each do |value, label| %>
            <label class="bg-base-100 border-base-300 hover:border-primary flex cursor-pointer items-start gap-3 rounded-box border p-4 transition-colors">
              <%= radio_button_tag "plan_configuration[goal]", value, @configuration.goal == value, class: "radio radio-primary mt-0.5" %>
              <span>
                <span class="font-semibold"><%= label %></span>
                <span class="text-base-content/70 mt-1 block text-sm"><%= Planning::PreviewPresenter::GOAL_DESCRIPTIONS.fetch(value) %></span>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-5">
        <legend class="fieldset-legend px-2 text-lg">Discipline</legend>
        <div class="flex flex-wrap gap-3">
          <% Planning::PreviewPresenter::DISCIPLINE_LABELS.each do |value, label| %>
            <label class="bg-base-100 border-base-300 flex cursor-pointer items-center gap-2 rounded-box border px-4 py-3">
              <%= radio_button_tag "plan_configuration[discipline]", value, @configuration.discipline == value, class: "radio radio-primary radio-sm" %>
              <span class="font-medium"><%= label %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-5">
        <legend class="fieldset-legend px-2 text-lg">Timing</legend>
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">
            Start date
            <%= date_field_tag "plan_configuration[starts_on]", @configuration.starts_on, class: "input w-full" %>
          </label>

          <div class="space-y-3">
            <div class="bg-base-100 border-base-300 rounded-box border p-4">
              <label class="flex cursor-pointer items-center gap-3 font-semibold">
                <%= radio_button_tag "plan_configuration[duration_mode]", "preset", @configuration.duration_mode == "preset", class: "radio radio-primary radio-sm" %>
                Calendar-month duration
              </label>
              <%= select_tag "plan_configuration[duration_months]", options_for_select([["1 month", 1], ["3 months", 3], ["6 months", 6]], @configuration.duration_months), class: "select mt-3 w-full" %>
            </div>

            <div class="bg-base-100 border-base-300 rounded-box border p-4">
              <label class="flex cursor-pointer items-center gap-3 font-semibold">
                <%= radio_button_tag "plan_configuration[duration_mode]", "custom", @configuration.duration_mode == "custom", class: "radio radio-primary radio-sm" %>
                Custom whole weeks
              </label>
              <%= number_field_tag "plan_configuration[custom_duration_weeks]", @configuration.custom_duration_weeks, min: 4, class: "input mt-3 w-full", aria: { label: "Custom duration in whole weeks" }, placeholder: "Minimum 4 weeks" %>
            </div>
          </div>
      </fieldset>

      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-5">
        <legend class="fieldset-legend px-2 text-lg">Target event</legend>
        <p class="text-base-content/70 mb-2 text-sm">Required only when your goal is Prepare for an Event.</p>
        <div class="grid gap-4 md:grid-cols-2">
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">Event name <%= text_field_tag "plan_configuration[event_name]", @configuration.event_name, class: "input w-full" %></label>
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">Event date <%= date_field_tag "plan_configuration[event_on]", @configuration.event_on, class: "input w-full" %></label>
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">Event discipline <%= select_tag "plan_configuration[event_discipline]", options_for_select(Planning::PreviewPresenter::DISCIPLINE_LABELS.map { |value, label| [label, value] }, @configuration.event_discipline), class: "select w-full" %></label>
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">Distance (km) <%= number_field_tag "plan_configuration[event_distance_km]", @configuration.event_distance_km, min: 1, step: 0.1, class: "input w-full" %></label>
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">Elevation (m) <%= number_field_tag "plan_configuration[event_elevation_m]", @configuration.event_elevation_m, min: 0, class: "input w-full" %></label>
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">Expected duration (minutes) <%= number_field_tag "plan_configuration[event_expected_duration_minutes]", @configuration.event_expected_duration_minutes, min: 1, class: "input w-full" %></label>
        </div>
      </fieldset>

      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-5">
        <legend class="fieldset-legend px-2 text-lg">Fitness and progression</legend>
        <div class="grid gap-5 md:grid-cols-2">
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">FTP (watts) <%= number_field_tag "plan_configuration[ftp_watts]", @configuration.ftp_watts, min: 1, required: true, class: "input w-full" %></label>
          <label class="bg-base-100 border-base-300 flex cursor-pointer items-center gap-3 self-end rounded-box border p-4 font-semibold">
            <%= hidden_field_tag "plan_configuration[include_base]", "0" %>
            <%= check_box_tag "plan_configuration[include_base]", "1", @configuration.include_base, class: "checkbox checkbox-primary" %>
            Include Base phase
          </label>
        </div>

        <div class="mt-4 grid gap-3 md:grid-cols-2">
          <label class="bg-base-100 border-base-300 flex cursor-pointer items-center gap-3 rounded-box border p-4 font-semibold">
            <%= radio_button_tag "plan_configuration[progression_mode]", "continuous", @configuration.progression_mode == "continuous", class: "radio radio-primary radio-sm" %>
            Continuous progression
          </label>
          <div class="bg-base-100 border-base-300 rounded-box border p-4">
            <label class="flex cursor-pointer items-center gap-3 font-semibold">
              <%= radio_button_tag "plan_configuration[progression_mode]", "hard_recovery_cycle", @configuration.progression_mode == "hard_recovery_cycle", class: "radio radio-primary radio-sm" %>
              Hard/recovery cycle
            </label>
            <label class="fieldset-label mt-3 flex-col items-start gap-2 font-medium">
              Hard weeks before recovery
              <%= number_field_tag "plan_configuration[hard_weeks_before_recovery]", @configuration.hard_weeks_before_recovery, min: 1, class: "input w-full" %>
            </label>
          </div>
        </div>
      </fieldset>

      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-5">
        <legend class="fieldset-legend px-2 text-lg">Weekly availability</legend>
        <p class="text-base-content/70 text-sm">Unselected days are rest days. Duration is exact except during recovery weeks and taper.</p>
        <div class="border-base-300 bg-base-100 mt-3 overflow-x-auto rounded-box border">
          <table class="table table-zebra">
            <thead><tr><th>Day</th><th>Train</th><th>Duration</th><th>Intent</th></tr></thead>
            <tbody>
              <% Date::DAYNAMES.rotate.each_with_index do |day_name, index| %>
                <% weekday = index + 1; slot = @configuration.slot_for(weekday) %>
                <tr>
                  <th class="font-semibold"><%= day_name %></th>
                  <td>
                    <%= hidden_field_tag "plan_configuration[availability][#{weekday}][weekday]", weekday %>
                    <%= check_box_tag "plan_configuration[availability][#{weekday}][enabled]", "1", slot.present?, class: "checkbox checkbox-primary checkbox-sm", aria: { label: "Train on #{day_name}" } %>
                  </td>
                  <td>
                    <label class="flex items-center gap-2">
                      <%= number_field_tag "plan_configuration[availability][#{weekday}][duration_minutes]", slot&.duration_minutes || 60, min: 30, class: "input input-sm w-24", aria: { label: "#{day_name} duration in minutes" } %>
                      <span class="text-base-content/60 text-sm">min</span>
                    </label>
                  </td>
                  <td><%= select_tag "plan_configuration[availability][#{weekday}][intent]", options_for_select([["Intervals", "intervals"], ["Endurance", "endurance"], ["Recovery", "recovery"], ["VO2 Max", "vo2_max"], ["Threshold", "threshold"], ["Sweet Spot", "sweet_spot"], ["Tempo", "tempo"]], slot&.intent || "endurance"), class: "select select-sm min-w-40", aria: { label: "#{day_name} workout intent" } %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </fieldset>

      <div class="card-actions justify-end">
        <%= link_to "Cancel", root_path, class: "btn btn-ghost" %>
        <%= submit_tag "Preview plan", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</section>
