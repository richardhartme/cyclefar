<section class="card bg-base-100 mx-auto w-full max-w-5xl shadow-sm">
  <div class="card-body gap-8">
    <div>
      <%= link_to "← Back to dashboard", root_path, class: "link link-primary font-semibold" %>
      <h1 class="card-title mt-5 text-3xl">Create training plan</h1>
      <p class="text-base-content/70 mt-2">Set your goal, schedule and progression preferences, then review a generated plan before creating it.</p>
    </div>

    <% if @configuration.errors.any? %>
      <section aria-labelledby="configuration-errors" role="alert" tabindex="-1" class="alert alert-error alert-soft items-start">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="mt-0.5 size-5 shrink-0" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.3 3.8 2.2 18a2 2 0 0 0 1.7 3h16.2a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0Z" />
        </svg>
        <div>
          <h2 id="configuration-errors" class="font-semibold">Please correct the plan configuration</h2>
          <ul class="mt-2 list-disc pl-5"><% @configuration.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
      </section>
    <% end %>

    <%= form_with url: preview_training_plan_path, scope: :plan_configuration, data: { turbo: false, controller: "plan-configuration", plan_configuration_end_date_url_value: end_date_training_plan_path, action: "formdata->plan-configuration#preserveDraft submit->plan-configuration#prepareSubmit" }, class: "space-y-6" do %>
      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-5" data-action="change->plan-configuration#update">
        <legend class="fieldset-legend px-2 text-lg">Goal</legend>
        <div class="grid gap-3 sm:grid-cols-2">
          <% Planning::PreviewPresenter::GOAL_LABELS.each do |value, label| %>
            <label class="bg-base-100 border-base-300 hover:border-primary flex cursor-pointer items-start gap-3 rounded-box border p-4 transition-colors">
              <%= radio_button_tag "plan_configuration[goal]", value, @configuration.goal == value, class: "radio radio-primary mt-0.5" %>
              <span>
                <span class="font-semibold"><%= label %></span>
                <span class="text-base-content/70 mt-1 block text-sm"><%= Planning::PreviewPresenter::GOAL_DESCRIPTIONS.fetch(value) %></span>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-5">
        <legend class="fieldset-legend px-2 text-lg">Timing</legend>
        <label class="fieldset-label flex-col items-start gap-2 font-semibold">
          Start date
          <%= date_field_tag "plan_configuration[starts_on]", @configuration.input_value(:starts_on), required: true, class: "input w-full", data: { plan_configuration_target: "startDate", action: "change->plan-configuration#refreshEndDate" }, aria: plan_field_aria(:starts_on) %>
          <%= render "field_errors", attribute: :starts_on %>
        </label>
        <fieldset class="mt-4 space-y-3" data-plan-configuration-target="duration" <%= "hidden disabled" if @configuration.event? %>>
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">
            Plan length
            <%= select_tag "plan_configuration[plan_length]", plan_select_options([["1 month", "1"], ["3 months", "3"], ["6 months", "6"], ["Custom weeks", "custom"]], @configuration.plan_length), class: "select w-full", data: { plan_configuration_target: "length", action: "change->plan-configuration#update" }, aria: plan_field_aria(:duration_months, :duration_mode) %>
            <%= render "field_errors", attribute: :duration_months %>
            <%= render "field_errors", attribute: :duration_mode %>
          </label>
          <fieldset data-plan-configuration-target="custom" <%= "hidden disabled" unless @configuration.duration_mode == "custom" %>>
            <label class="fieldset-label flex-col items-start gap-2 font-semibold">
              Custom whole weeks
              <%= number_field_tag "plan_configuration[custom_duration_weeks]", @configuration.input_value(:custom_duration_weeks), min: Planning::Rules::MINIMUM_CUSTOM_WEEKS, step: 1, required: true, class: "input w-full", data: { plan_configuration_target: "weeks", action: "input->plan-configuration#refreshEndDate" }, aria: plan_field_aria(:custom_duration_weeks, help: "custom-weeks-help") %>
              <span id="custom-weeks-help" class="text-base-content/70 text-sm font-normal">Minimum four whole weeks.</span>
              <%= render "field_errors", attribute: :custom_duration_weeks %>
            </label>
          </fieldset>
          <p class="text-sm" aria-live="polite" aria-atomic="true" data-plan-configuration-target="endDate">Plan ends on <%= @configuration.ends_on&.to_fs(:long) || "— choose a valid start date and plan length" unless @configuration.event? %></p>
        </fieldset>
        <p class="mt-3 text-sm" data-plan-configuration-target="eventTiming" <%= "hidden" unless @configuration.event? %>>Your plan runs from your start date to your event date.</p>
      </fieldset>

      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-5" data-plan-configuration-target="event" <%= "hidden disabled" unless @configuration.event? %>>
        <legend class="fieldset-legend px-2 text-lg">Target event</legend>
        <div class="grid gap-4 md:grid-cols-2">
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">
            Event name
            <%= text_field_tag "plan_configuration[event_name]", @configuration.input_value(:event_name), required: true, class: "input w-full", aria: plan_field_aria(:event_name) %>
            <%= render "field_errors", attribute: :event_name %>
          </label>
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">
            Event date
            <%= date_field_tag "plan_configuration[event_on]", @configuration.input_value(:event_on), required: true, class: "input w-full", aria: plan_field_aria(:event_on, help: "event-date-help") %>
            <span id="event-date-help" class="text-base-content/70 text-sm font-normal">At least four weeks (28 days) after your start date.</span>
            <%= render "field_errors", attribute: :event_on %>
          </label>
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">
            Event discipline
            <%= select_tag "plan_configuration[event_discipline]", plan_select_options(Planning::PreviewPresenter::DISCIPLINE_LABELS.map { |value, label| [label, value] }, @configuration.event_discipline), include_blank: @configuration.event_discipline.blank? ? "Choose event discipline" : false, required: true, class: "select w-full", aria: plan_field_aria(:event_discipline, help: "event-discipline-help") %>
            <span id="event-discipline-help" class="text-base-content/70 text-sm font-normal">Shapes the workout mix as your event approaches.</span>
            <%= render "field_errors", attribute: :event_discipline %>
          </label>
        </div>
        <% optional_errors = %i[event_distance_km event_elevation_m event_expected_duration_minutes].any? { |attribute| @configuration.errors[attribute].any? } %>
        <%= hidden_field_tag "plan_configuration[event_details_open]", @configuration.event_details_open ? "1" : "0", data: { plan_configuration_target: "disclosureState" } %>
        <details class="mt-4" data-plan-configuration-target="optionalDetails" data-action="toggle->plan-configuration#disclose invalid->plan-configuration#revealOptional:capture" <%= "open" if @configuration.event_details_open || optional_errors %>>
          <summary class="cursor-pointer font-semibold">Additional event details (optional)</summary>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            <label class="fieldset-label flex-col items-start gap-2 font-semibold">
              Expected riding time (minutes)
              <%= number_field_tag "plan_configuration[event_expected_duration_minutes]", @configuration.input_value(:event_expected_duration_minutes), min: 1, step: 1, class: "input w-full", aria: plan_field_aria(:event_expected_duration_minutes, help: "event-duration-help") %>
              <span id="event-duration-help" class="text-base-content/70 text-sm font-normal">Influences taper length: normally seven days, or fourteen for rides over five hours when the plan allows.</span>
              <%= render "field_errors", attribute: :event_expected_duration_minutes %>
            </label>
            <label class="fieldset-label flex-col items-start gap-2 font-semibold">
              Distance (km)
              <%= number_field_tag "plan_configuration[event_distance_km]", @configuration.input_value(:event_distance_km), min: 0.1, step: 0.1, class: "input w-full", aria: plan_field_aria(:event_distance_km, help: "event-distance-help") %>
              <span id="event-distance-help" class="text-base-content/70 text-sm font-normal">Shown on the calendar for reference.</span>
              <%= render "field_errors", attribute: :event_distance_km %>
            </label>
            <label class="fieldset-label flex-col items-start gap-2 font-semibold">
              Elevation (m)
              <%= number_field_tag "plan_configuration[event_elevation_m]", @configuration.input_value(:event_elevation_m), min: 0, step: 1, class: "input w-full", aria: plan_field_aria(:event_elevation_m, help: "event-elevation-help") %>
              <span id="event-elevation-help" class="text-base-content/70 text-sm font-normal">Shown on the calendar for reference.</span>
              <%= render "field_errors", attribute: :event_elevation_m %>
            </label>
          </div>
        </details>
      </fieldset>

      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-5" data-action="change->plan-configuration#update">
        <legend class="fieldset-legend px-2 text-lg">Fitness and progression</legend>
          <label class="fieldset-label flex-col items-start gap-2 font-semibold">
            FTP (watts)
            <%= number_field_tag "plan_configuration[ftp_watts]", @configuration.input_value(:ftp_watts), min: 1, required: true, class: "input w-full", aria: plan_field_aria(:ftp_watts) %>
            <%= render "field_errors", attribute: :ftp_watts %>
          </label>
          <label class="mt-5 bg-base-100 border-base-300 flex cursor-pointer items-center gap-3 self-end rounded-box border p-4">
            <%= hidden_field_tag "plan_configuration[include_base]", "0" %>
            <%= check_box_tag "plan_configuration[include_base]", "1", @configuration.include_base, class: "checkbox checkbox-primary", data: { plan_configuration_target: "base" } %>
            <span>
                <span class="font-semibold">Include Base phase</span>
                <span class="text-base-content/70 mt-1 block text-sm">Adds an initial foundation phase before Build and Speciality.</span>
            </span>
          </label>
          <p class="text-base-content/70 mt-3 text-sm" aria-live="polite" aria-atomic="true" data-plan-configuration-target="phaseSequence">Phases: <%= "Base → " if @configuration.include_base %>Build → Speciality<%= " → Taper" if @configuration.event? %>.</p>

        <div class="mt-4 grid gap-3 md:grid-cols-2">
          <label class="bg-base-100 border-base-300 flex cursor-pointer items-center gap-3 rounded-box border p-4">
            <%= radio_button_tag "plan_configuration[progression_mode]", "continuous", @configuration.progression_mode == "continuous", class: "radio radio-primary radio-sm", data: { plan_configuration_target: "progression" } %>
            <span>
                <span class="font-semibold">Continuous progression — no scheduled recovery weeks</span>
                <span class="text-base-content/70 mt-1 block text-sm">Training progresses within load limits. Event taper, feedback adjustments and time off still apply.</span>
            </span>
          </label>
          <div class="bg-base-100 border-base-300 rounded-box border p-4">
            <label class="flex cursor-pointer items-center gap-3 font-semibold">
              <%= radio_button_tag "plan_configuration[progression_mode]", "hard_recovery_cycle", @configuration.progression_mode == "hard_recovery_cycle", class: "radio radio-primary radio-sm", data: { plan_configuration_target: "progression" } %>
              Hard/recovery cycle
            </label>
            <fieldset class="mt-3" data-plan-configuration-target="cycle" <%= "hidden disabled" unless @configuration.progression_mode == "hard_recovery_cycle" %>>
              <label class="fieldset-label flex-col items-start gap-2 font-medium">
                Hard weeks before recovery
                <%= number_field_tag "plan_configuration[hard_weeks_before_recovery]", @configuration.input_value(:hard_weeks_before_recovery), min: 1, step: 1, required: true, class: "input w-full", aria: plan_field_aria(:hard_weeks_before_recovery, help: "cycle-weeks-help") %>
                <span id="cycle-weeks-help" class="text-base-content/70 text-sm font-normal">One easier week follows this many hard weeks.</span>
                <%= render "field_errors", attribute: :hard_weeks_before_recovery %>
              </label>
            </fieldset>
          </div>
        </div>
        <p class="text-base-content/70 mt-3 text-sm">Scheduled recovery weeks and event taper can shorten normal sessions and change session types. Manual recovery and time off remain available in either mode.</p>
      </fieldset>

      <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-5">
        <legend class="fieldset-legend px-2 text-lg">Weekly availability</legend>
        <p class="text-base-content/70 text-sm">Choose your training days and session lengths. Select Intervals to let CycleFar choose the workout type, or select a specific type yourself.</p>
        <p class="text-base-content/70 mt-2 text-sm">Endurance and Recovery stay those session types. Unselected days are rest days. Your goal does not add training days or available time.</p>
        <p class="text-base-content/70 mt-2 text-sm">VO2 Max, Threshold, Sweet Spot and Tempo keep your choice in normal weeks; recovery weeks and taper may shorten sessions or replace hard work with easier riding.</p>
        <div class="border-base-300 bg-base-100 mt-3 overflow-x-auto rounded-box border">
          <table class="table table-zebra">
            <thead><tr><th>Day</th><th>Train</th><th>Duration</th><th>Session type</th></tr></thead>
            <tbody>
              <% Date::DAYNAMES.rotate.each_with_index do |day_name, index| %>
                <% weekday = index + 1; slot = @configuration.slot_for(weekday) %>
                <tr>
                  <th class="font-semibold"><%= day_name %></th>
                  <td>
                    <%= hidden_field_tag "plan_configuration[availability][#{weekday}][weekday]", weekday %>
                    <%= check_box_tag "plan_configuration[availability][#{weekday}][enabled]", "1", slot.present?, class: "checkbox checkbox-primary checkbox-sm", aria: { label: "Train on #{day_name}" } %>
                  </td>
                  <td>
                    <label class="flex items-center gap-2">
                      <%= number_field_tag "plan_configuration[availability][#{weekday}][duration_minutes]", slot&.duration_minutes || 60, min: 30, class: "input input-sm w-24", aria: { label: "#{day_name} duration in minutes" } %>
                      <span class="text-base-content/60 text-sm">min</span>
                    </label>
                  </td>
                  <td><%= select_tag "plan_configuration[availability][#{weekday}][intent]", options_for_select([["Intervals — chosen for your goal", "intervals"], ["Endurance", "endurance"], ["Recovery", "recovery"], ["VO2 Max", "vo2_max"], ["Threshold", "threshold"], ["Sweet Spot", "sweet_spot"], ["Tempo", "tempo"]], slot&.intent || "endurance"), class: "select select-sm min-w-40", aria: { label: "#{day_name} session type" } %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </fieldset>

      <div class="card-actions justify-end">
        <%= link_to "Cancel", root_path, class: "btn btn-ghost" %>
        <%= submit_tag "Preview plan", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</section>
