<section class="max-w-6xl">
  <h1 class="mb-4 text-3xl font-semibold">Create training plan</h1>
  <p class="mb-8 text-slate-600">Set your goal, schedule and progression preferences, then review a generated plan before creating it.</p>

  <% if @configuration.errors.any? %>
    <section aria-labelledby="configuration-errors" class="mb-6 rounded-lg border border-red-300 bg-red-50 p-4 text-red-900">
      <h2 id="configuration-errors" class="font-semibold">Please correct the plan configuration</h2>
      <ul class="mt-2 list-disc pl-5"><% @configuration.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </section>
  <% end %>

  <%= form_with url: preview_training_plan_path, scope: :plan_configuration, data: { turbo: false }, class: "space-y-10" do %>
    <fieldset>
      <legend class="text-xl font-semibold">Goal</legend>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <% Planning::PreviewPresenter::GOAL_LABELS.each do |value, label| %>
          <label class="rounded border border-slate-300 p-3"><%= radio_button_tag "plan_configuration[goal]", value, @configuration.goal == value %> <span class="font-semibold"><%= label %></span><span class="mt-1 block text-sm text-slate-600"><%= Planning::PreviewPresenter::GOAL_DESCRIPTIONS.fetch(value) %></span></label>
        <% end %>
      </div>
    </fieldset>

    <fieldset>
      <legend class="text-xl font-semibold">Discipline</legend>
      <div class="mt-3 flex flex-wrap gap-3">
        <% Planning::PreviewPresenter::DISCIPLINE_LABELS.each do |value, label| %>
          <label><%= radio_button_tag "plan_configuration[discipline]", value, @configuration.discipline == value %> <%= label %></label>
        <% end %>
      </div>
    </fieldset>

    <fieldset class="space-y-4">
      <legend class="text-xl font-semibold">Timing</legend>
      <label class="block">Start date <%= date_field_tag "plan_configuration[starts_on]", @configuration.starts_on %></label>
      <div>
        <label><%= radio_button_tag "plan_configuration[duration_mode]", "preset", @configuration.duration_mode == "preset" %> Calendar-month duration</label>
        <%= select_tag "plan_configuration[duration_months]", options_for_select([["1 month", 1], ["3 months", 3], ["6 months", 6]], @configuration.duration_months) %>
      </div>
      <label><%= radio_button_tag "plan_configuration[duration_mode]", "custom", @configuration.duration_mode == "custom" %> Custom whole weeks (minimum 4)
        <%= number_field_tag "plan_configuration[custom_duration_weeks]", @configuration.custom_duration_weeks, min: 4 %></label>
    </fieldset>

    <fieldset class="space-y-3">
      <legend class="text-xl font-semibold">Target event</legend>
      <p class="text-sm text-slate-600">Required only when your goal is Prepare for an Event.</p>
      <label class="block">Event name <%= text_field_tag "plan_configuration[event_name]", @configuration.event_name %></label>
      <label class="block">Event date <%= date_field_tag "plan_configuration[event_on]", @configuration.event_on %></label>
      <label class="block">Event discipline <%= select_tag "plan_configuration[event_discipline]", options_for_select(Planning::PreviewPresenter::DISCIPLINE_LABELS.map { |value, label| [label, value] }, @configuration.event_discipline) %></label>
      <label class="block">Distance (km) <%= number_field_tag "plan_configuration[event_distance_km]", @configuration.event_distance_km, min: 1, step: 0.1 %></label>
      <label class="block">Elevation (m) <%= number_field_tag "plan_configuration[event_elevation_m]", @configuration.event_elevation_m, min: 0 %></label>
      <label class="block">Expected duration (minutes) <%= number_field_tag "plan_configuration[event_expected_duration_minutes]", @configuration.event_expected_duration_minutes, min: 1 %></label>
    </fieldset>

    <fieldset class="space-y-3">
      <legend class="text-xl font-semibold">Fitness and progression</legend>
      <label class="block">FTP (watts) <%= number_field_tag "plan_configuration[ftp_watts]", @configuration.ftp_watts, min: 1, required: true %></label>
      <label><%= hidden_field_tag "plan_configuration[include_base]", "0" %><%= check_box_tag "plan_configuration[include_base]", "1", @configuration.include_base %> Include Base phase</label>
      <label><%= radio_button_tag "plan_configuration[progression_mode]", "continuous", @configuration.progression_mode == "continuous" %> Continuous progression</label>
      <label><%= radio_button_tag "plan_configuration[progression_mode]", "hard_recovery_cycle", @configuration.progression_mode == "hard_recovery_cycle" %> Hard/recovery cycle</label>
      <label>Hard weeks before recovery <%= number_field_tag "plan_configuration[hard_weeks_before_recovery]", @configuration.hard_weeks_before_recovery, min: 1 %></label>
    </fieldset>

    <fieldset>
      <legend class="text-xl font-semibold">Weekly availability</legend>
      <p class="mt-1 text-sm text-slate-600">Unselected days are rest days. Duration is exact except during recovery weeks and taper.</p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left">
          <thead><tr><th>Day</th><th>Train</th><th>Duration</th><th>Intent</th></tr></thead>
          <tbody>
            <% Date::DAYNAMES.rotate.each_with_index do |day_name, index| %>
              <% weekday = index + 1; slot = @configuration.slot_for(weekday) %>
              <tr>
                <td><%= day_name %></td>
                <td><%= hidden_field_tag "plan_configuration[availability][#{weekday}][weekday]", weekday %><%= check_box_tag "plan_configuration[availability][#{weekday}][enabled]", "1", slot.present? %></td>
                <td><%= number_field_tag "plan_configuration[availability][#{weekday}][duration_minutes]", slot&.duration_minutes || 60, min: 30 %> min</td>
                <td><%= select_tag "plan_configuration[availability][#{weekday}][intent]", options_for_select([["Intervals", "intervals"], ["Endurance", "endurance"], ["Recovery", "recovery"], ["VO2 Max", "vo2_max"], ["Threshold", "threshold"], ["Sweet Spot", "sweet_spot"], ["Tempo", "tempo"]], slot&.intent || "endurance") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </fieldset>

    <%= submit_tag "Preview plan", class: "rounded bg-teal-800 px-5 py-3 font-semibold text-white" %>
  <% end %>
</section>
