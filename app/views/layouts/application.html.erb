<!DOCTYPE html>
<html lang="en" data-theme="cyclefar">
  <head>
    <title><%= content_for(:title) || "CycleFar" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="CycleFar">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-200 text-base-content min-h-screen">
    <a href="#main-content" class="btn btn-primary sr-only fixed left-4 top-4 z-50 focus:not-sr-only">Skip to main content</a>

    <header class="bg-base-100/85 border-base-300 sticky top-0 z-40 border-b backdrop-blur">
      <nav aria-label="Main navigation" class="navbar mx-auto min-h-16 w-full px-4 sm:px-6" style="max-width: 1536px">
        <div class="navbar-start">
          <div class="flex items-center gap-3">
            <%= link_to "CycleFar", root_path, class: "text-primary text-xl font-bold tracking-tight hover:opacity-80" %>
            <p class="text-base-content/55 border-base-300 hidden border-l pl-3 text-xs font-medium tracking-wide sm:block">Plan smart. Ride far.</p>
          </div>
        </div>
        <% if authenticated? %>
          <div class="navbar-end gap-3">
            <ul class="menu menu-horizontal bg-base-200 border-base-300 rounded-field border p-1">
              <li><%= link_to "Calendar", root_path, class: "rounded-field #{'menu-active bg-base-100 text-primary font-semibold shadow-sm' unless current_page?(settings_path)}", aria: ({ current: "page" } unless current_page?(settings_path)) %></li>
              <li><%= link_to "Settings", settings_path, class: "rounded-field #{'menu-active bg-base-100 text-primary font-semibold shadow-sm' if current_page?(settings_path)}", aria: ({ current: "page" } if current_page?(settings_path)) %></li>
            </ul>
            <span class="text-base-content/70 max-w-40 truncate text-sm" title="<%= Current.user.email_address %>"><%= Current.user.email_address %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
          </div>
        <% else %>
          <div class="navbar-end gap-2">
            <%= link_to "Sign In", new_session_path, class: "btn btn-ghost btn-sm" %>
            <%= link_to "Register", new_registration_path, class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </nav>
    </header>

    <main id="main-content" tabindex="-1" class="mx-auto w-full px-4 py-8 focus:outline-none sm:px-6 sm:py-10" style="max-width: 1536px">
      <% if notice %>
        <div role="status" class="alert alert-success alert-soft mb-6">
          <span><%= notice %></span>
        </div>
      <% end %>
      <% if alert %>
        <div role="alert" class="alert alert-error alert-soft mb-6">
          <span><%= alert %></span>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <% if (version = ENV["KAMAL_VERSION"].presence) %>
      <footer aria-label="Deployed version" class="mx-auto w-full px-6 pb-6 text-right text-xs text-base-content/70" style="max-width: 1536px">
        Version <code class="break-all" title="<%= version %>"><%= version.match?(/\A[0-9a-f]{40}\z/i) ? version.first(7) : version %></code>
      </footer>
    <% end %>
  </body>
</html>
