<section class="max-w-6xl rounded-lg border border-slate-200 bg-white p-6">
  <%= link_to "Back to calendar", root_path, class: "font-semibold text-teal-800 underline" %>
  <h1 id="workout-detail-title" class="mt-5 text-3xl font-semibold"><%= @workout.name %></h1>
  <p class="mt-2 text-slate-600"><%= @workout.scheduled_on.to_fs(:long) %> · <%= @workout.plan_phase.kind.humanize %><%= " · #{@workout.duration_minutes} min" unless @workout.ftp_test? %></p>

  <% if @workout.ftp_test? %>
    <p class="mt-4">Use your preferred FTP assessment protocol. CycleFar does not prescribe a test workout.</p>
    <% if @workout.planned? %>
      <%= button_to "Test done — update FTP", complete_test_planned_workout_path(@workout), class: "mt-6 rounded bg-teal-800 px-3 py-2 text-white" %>
    <% else %>
      <p class="mt-5 font-semibold text-teal-800">FTP test recorded</p>
    <% end %>
  <% elsif @workout.structured? %>
    <p class="mt-4"><%= @workout.purpose %></p>
    <p class="mt-3"><strong>Main set:</strong> <%= @workout.workout_steps.select { |step| step.group_key == "main" }.map(&:label).uniq.join(", ").presence || "Steady aerobic work" %></p>
    <p class="mt-3 text-slate-600">FTP basis: <%= workout_ftp_watts(@workout) %> W</p>
    <%= workout_profile_svg(@workout, detailed: true) %>
    <dl class="mt-5 grid grid-cols-3 gap-4 rounded bg-slate-100 p-4">
      <div><dt>IF</dt><dd><%= format("%.2f", @workout.estimated_if) %></dd></div>
      <div><dt>TSS</dt><dd><%= @workout.estimated_tss.round %></dd></div>
      <div><dt>Work</dt><dd><%= @workout.estimated_work_kj.round %> kJ</dd></div>
    </dl>

    <h2 class="mt-8 text-xl font-semibold">Steps</h2>
    <ol class="mt-3 space-y-2">
      <% @workout.workout_steps.each do |step| %>
        <li><strong><%= step.label %></strong> · <%= step.duration_seconds / 60.0 %> min · <%= step.target_low_pct_ftp %>–<%= step.target_high_pct_ftp %>% FTP (<%= workout_step_watt_targets(@workout, step) %>)</li>
      <% end %>
    </ol>

    <% if @workout.planned? %>
      <h2 class="mt-8 text-xl font-semibold">Adjust workout</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        <% { "Same" => "same", "Easier" => "easier", "Harder" => "harder", "Shorter by 15 min" => "shorter", "Longer by 15 min" => "longer" }.each do |label, action| %>
          <%= button_to label, shuffle_planned_workout_path(@workout), params: { action_kind: action }, class: "rounded border px-3 py-2" %>
        <% end %>
      </div>

      <%= form_with url: change_planned_workout_path(@workout), method: :post, class: "mt-5 space-y-2" do %>
        <h3 class="font-semibold">Change workout</h3>
        <%= select_tag :subtype, options_for_select(Training::V1::Rules::SUBTYPE_NAMES.map { |key, label| [ label, key ] }, @workout.subtype) %>
        <%= number_field_tag :duration_minutes, @workout.duration_minutes, min: 30 %>
        <%= submit_tag "Change workout", class: "rounded bg-teal-800 px-3 py-2 text-white" %>
      <% end %>

      <div class="mt-5 grid gap-5 md:grid-cols-2">
        <%= form_with url: move_planned_workout_path(@workout), method: :post, class: "space-y-2" do %>
          <h3 class="font-semibold">Move workout</h3>
          <%= date_field_tag :scheduled_on, @workout.scheduled_on, min: @workout.training_plan.starts_on, max: @workout.training_plan.ends_on %>
          <%= submit_tag "Move to date", class: "rounded border px-3 py-2" %>
        <% end %>

        <% if @workout.workout? %>
          <%= form_with url: copy_planned_workout_path(@workout), method: :post, class: "space-y-2" do %>
            <h3 class="font-semibold">Copy workout</h3>
            <%= date_field_tag :scheduled_on, nil, min: @workout.training_plan.starts_on, max: @workout.training_plan.ends_on, required: true %>
            <%= submit_tag "Copy to date", class: "rounded border px-3 py-2" %>
          <% end %>
        <% end %>
      </div>

      <%= form_with url: complete_planned_workout_path(@workout), method: :post, class: "mt-5 space-y-2" do %>
        <h3 class="font-semibold">Mark completed</h3>
        <%= number_field_tag :rpe, nil, min: 1, max: 10, required: true, placeholder: "RPE 1–10" %>
        <%= select_tag :completion_quality, options_for_select([["Completed as planned", "as_planned"], ["Struggled but completed", "struggled_completed"], ["Could not complete", "could_not_complete"]]) %>
        <%= submit_tag "Save completion", class: "rounded bg-teal-800 px-3 py-2 text-white" %>
      <% end %>

      <% if @workout.scheduled_on <= Date.current %>
        <%= form_with url: miss_planned_workout_path(@workout), method: :post, class: "mt-5 space-y-2" do %>
          <h3 class="font-semibold">Mark missed</h3>
          <%= select_tag :resolution, options_for_select([["Leave remaining plan unchanged", "leave_unchanged"], ["Move workout", "move"], ["Replan upcoming workouts", "replan"]]) %>
          <%= date_field_tag :scheduled_on, @workout.scheduled_on, min: @workout.training_plan.starts_on, max: @workout.training_plan.ends_on %>
          <%= submit_tag "Resolve missed workout", class: "rounded border px-3 py-2" %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <p class="mt-4"><%= @workout.purpose %></p>
    <p class="mt-4 rounded bg-slate-100 p-4 text-slate-700">The detailed structure for this workout will be generated when it enters the next 14 days.</p>
  <% end %>
</section>
