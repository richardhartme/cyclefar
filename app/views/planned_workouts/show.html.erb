<section class="card bg-base-100 border-base-300 mx-auto w-full max-w-5xl border shadow-sm">
  <div class="card-body gap-6 p-6 sm:p-8">
    <header>
      <%= link_to "Back to calendar", root_path, class: "link link-primary font-semibold" %>
      <h1 id="workout-detail-title" class="card-title mt-5 text-3xl"><%= @workout.name %></h1>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="badge badge-primary badge-outline"><%= @workout.scheduled_on.to_fs(:long) %></span>
        <span class="badge badge-secondary badge-outline"><%= @workout.plan_phase.kind.humanize %></span>
        <span class="badge badge-ghost"><%= @workout.duration_minutes %> min</span>
      </div>
    </header>

    <% if @workout.structured? %>
      <div>
        <p><%= @workout.purpose %></p>
        <p class="mt-3"><strong>Main set:</strong> <%= @workout.workout_steps.select { |step| step.group_key == "main" }.map(&:label).uniq.join(", ").presence || "Steady aerobic work" %></p>
        <p class="text-base-content/70 mt-3">FTP basis: <%= workout_ftp_watts(@workout) %> W</p>
        <%= workout_profile_svg(@workout, detailed: true) %>
      </div>
      <dl class="stats stats-vertical bg-base-200 w-full shadow-sm sm:stats-horizontal">
        <div class="stat"><dt class="stat-title">IF</dt><dd class="stat-value text-2xl"><%= format("%.2f", @workout.estimated_if) %></dd></div>
        <div class="stat"><dt class="stat-title">TSS</dt><dd class="stat-value text-2xl"><%= @workout.estimated_tss.round %></dd></div>
        <div class="stat"><dt class="stat-title">Work</dt><dd class="stat-value text-2xl"><%= @workout.estimated_work_kj.round %> kJ</dd></div>
      </dl>

      <h2 class="text-xl font-semibold">Steps</h2>
      <ol class="space-y-2">
        <% @workout.workout_steps.each do |step| %>
          <li>
            <div class="rounded-box border-base-300 mb-3 border p-4 shadow-sm" style="background-color: color-mix(in srgb, <%= workout_step_color(step) %> 20%, white)">
              <strong><%= step.label %></strong> · <%= step.duration_seconds / 60.0 %> min · <%= step.target_low_pct_ftp %>–<%= step.target_high_pct_ftp %>% FTP (<%= workout_step_watt_targets(@workout, step) %>)
            </div>
          </li>
        <% end %>
      </ol>

      <% if @workout.planned? && @workout.workout? %>
        <div class="divider my-0"></div>
        <h2 class="text-xl font-semibold">Adjust workout</h2>
        <div class="flex flex-wrap gap-2">
          <% { "Same" => "same", "Easier" => "easier", "Harder" => "harder", "Shorter by 15 min" => "shorter", "Longer by 15 min" => "longer" }.each do |label, action| %>
            <%= button_to label, shuffle_planned_workout_path(@workout), params: { action_kind: action }, class: "btn btn-outline btn-primary btn-sm" %>
          <% end %>
        </div>
      <% end %>

      <% if @workout.planned? && (@workout.workout? || @workout.opener?) %>
        <%= form_with url: change_planned_workout_path(@workout), method: :post, class: "fieldset bg-base-200 border-base-300 rounded-box border p-5" do %>
          <h3 class="text-lg font-semibold">Change workout</h3>
          <%= label_tag :subtype, "Workout type", class: "fieldset-label font-semibold" %>
          <% workout_types = Training::V1::Rules::SUBTYPE_NAMES.map { |key, label| [ label, key ] } + [["Opener", "opener"]] %>
          <% selected_workout_type = @workout.opener? ? "opener" : @workout.subtype %>
          <%= select_tag :subtype, options_for_select(workout_types, selected_workout_type), class: "select w-full" %>
          <%= label_tag :duration_minutes, "Duration (minutes)", class: "fieldset-label mt-2 font-semibold" %>
          <%= number_field_tag :duration_minutes, @workout.duration_minutes, min: 30, max: (@workout.opener? ? 45 : nil), class: "input w-full" %>
          <p class="fieldset-label">Openers are 30–45 minute activation workouts for an event.</p>
          <div class="mt-3"><%= submit_tag "Change workout", class: "btn btn-primary" %></div>
        <% end %>
      <% end %>

      <% if @material_change_proposal %>
        <section class="alert alert-warning alert-soft items-start" aria-label="Optional upcoming replan">
          <div>
            <h3 class="font-semibold">Replan upcoming workouts?</h3>
            <p class="mt-1"><%= @material_change_proposal.reason %></p>
            <% if @material_change_error %>
              <p role="status"><%= @material_change_error %></p>
              <p>To review a fresh replan, change the workout again after dismissing this proposal.</p>
            <% end %>
            <div class="mt-3 flex flex-wrap gap-2">
              <% unless @material_change_error %>
                <%= button_to "Replan upcoming workouts", accept_adaptation_proposal_path(@material_change_proposal), class: "btn btn-primary btn-sm" %>
              <% end %>
              <%= button_to "Keep rest of plan unchanged", reject_adaptation_proposal_path(@material_change_proposal), method: :delete, class: "btn btn-ghost btn-sm" %>
            </div>
          </div>
        </section>
      <% end %>

      <% if @workout.planned? %>
        <div class="grid gap-5 md:grid-cols-2">
          <%= form_with url: move_planned_workout_path(@workout), method: :post, class: "fieldset border-base-300 rounded-box border p-5" do %>
            <h3 class="text-lg font-semibold">Move workout</h3>
            <%= label_tag :move_scheduled_on, "New date", class: "fieldset-label font-semibold" %>
            <%= date_field_tag :scheduled_on, @workout.scheduled_on, id: "move_scheduled_on", min: @workout.training_plan.starts_on, max: @workout.training_plan.ends_on, class: "input w-full" %>
            <div class="mt-3"><%= submit_tag "Move to date", class: "btn btn-outline btn-primary" %></div>
          <% end %>

          <% if @workout.workout? %>
            <%= form_with url: copy_planned_workout_path(@workout), method: :post, class: "fieldset border-base-300 rounded-box border p-5" do %>
              <h3 class="text-lg font-semibold">Copy workout</h3>
              <%= label_tag :copy_scheduled_on, "Copy to date", class: "fieldset-label font-semibold" %>
              <%= date_field_tag :scheduled_on, nil, id: "copy_scheduled_on", min: @workout.training_plan.starts_on, max: @workout.training_plan.ends_on, required: true, class: "input w-full" %>
              <div class="mt-3"><%= submit_tag "Copy to date", class: "btn btn-outline btn-primary" %></div>
            <% end %>
          <% end %>
        </div>

        <% if @workout.workout? || @workout.opener? %>
          <%= form_with url: complete_planned_workout_path(@workout), method: :post, class: "fieldset bg-base-200 border-base-300 rounded-box border p-5" do %>
            <h3 class="text-lg font-semibold">Mark completed</h3>
            <%= label_tag :rpe, "RPE (1–10)", class: "fieldset-label font-semibold" %>
            <%= number_field_tag :rpe, nil, min: 1, max: 10, required: true, class: "input w-full sm:w-40" %>
            <%= label_tag :completion_quality, "Completion quality", class: "fieldset-label mt-2 font-semibold" %>
            <%= select_tag :completion_quality, options_for_select([["Completed as planned", "as_planned"], ["Struggled but completed", "struggled_completed"], ["Could not complete", "could_not_complete"]]), class: "select w-full" %>
            <div class="mt-3"><%= submit_tag "Save completion", class: "btn btn-primary" %></div>
          <% end %>
        <% end %>

        <% if @workout.scheduled_on <= Date.current %>
          <%= form_with url: miss_planned_workout_path(@workout), method: :post, class: "fieldset border-base-300 rounded-box border p-5" do %>
            <h3 class="text-lg font-semibold">Mark missed</h3>
            <%= label_tag :resolution, "What happens next?", class: "fieldset-label font-semibold" %>
            <%= select_tag :resolution, options_for_select([["Leave remaining plan unchanged", "leave_unchanged"], ["Move workout", "move"], ["Replan upcoming workouts", "replan"]]), class: "select w-full" %>
            <%= label_tag :missed_scheduled_on, "New date if moving", class: "fieldset-label mt-2 font-semibold" %>
            <%= date_field_tag :scheduled_on, @workout.scheduled_on, id: "missed_scheduled_on", min: @workout.training_plan.starts_on, max: @workout.training_plan.ends_on, class: "input w-full" %>
            <div class="mt-3"><%= submit_tag "Resolve missed workout", class: "btn btn-outline btn-primary" %></div>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <p><%= @workout.purpose %></p>
      <div role="note" class="alert alert-info alert-soft">The detailed structure for this workout will be generated when it enters the next 14 days.</div>
    <% end %>
  </div>
</section>
