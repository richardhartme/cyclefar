<%# Two-panel shell for sign-in and registration. Pass title/subtitle locals and the form as the block. %>
<section class="border-base-300 bg-base-100 mx-auto grid w-full max-w-5xl overflow-hidden rounded-3xl border shadow-xl shadow-indigo-900/5 lg:grid-cols-5">
  <aside aria-label="About CycleFar" class="relative isolate hidden flex-col justify-between gap-10 overflow-hidden bg-indigo-50 p-10 lg:col-span-2 lg:flex">
    <div aria-hidden="true" class="absolute -left-16 -top-16 -z-10 h-64 w-64 rounded-full bg-indigo-200/70 blur-3xl"></div>
    <div aria-hidden="true" class="absolute -bottom-20 -right-16 -z-10 h-64 w-64 rounded-full bg-pink-200/70 blur-3xl"></div>

    <div>
      <p class="text-3xl font-bold tracking-tight text-slate-900">Plan smart.<br>Ride far.</p>
      <ul class="mt-8 space-y-4 text-slate-700">
        <li class="flex gap-3"><span aria-hidden="true" class="text-primary font-bold">&#10003;</span> 100% free</li>
        <li class="flex gap-3"><span aria-hidden="true" class="text-primary font-bold">&#10003;</span> Workouts synced to Intervals.icu</li>
        <li class="flex gap-3"><span aria-hidden="true" class="text-primary font-bold">&#10003;</span> A plan built around the days you can ride</li>
        <li class="flex gap-3"><span aria-hidden="true" class="text-primary font-bold">&#10003;</span> Adapts when life gets in the way</li>
      </ul>
    </div>

    <div aria-hidden="true" class="rounded-2xl border border-white bg-white/80 p-4 shadow-lg shadow-indigo-900/10">
      <div class="flex items-center justify-between text-sm">
        <span class="font-semibold text-slate-900">Threshold 3x8</span>
        <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800">Intervals</span>
      </div>
      <svg viewBox="0 0 320 70" class="mt-3 h-auto w-full" role="presentation">
        <polygon points="0,70 0,50 40,38 40,70" fill="#94a3b8"/>
        <rect x="40" y="50" width="30" height="20" fill="#7dd3fc"/>
        <rect x="70" y="18" width="50" height="52" fill="#f59e0b"/>
        <rect x="120" y="50" width="20" height="20" fill="#7dd3fc"/>
        <rect x="140" y="18" width="50" height="52" fill="#f59e0b"/>
        <rect x="190" y="50" width="20" height="20" fill="#7dd3fc"/>
        <rect x="210" y="18" width="50" height="52" fill="#f59e0b"/>
        <polygon points="260,50 320,58 320,70 260,70" fill="#7dd3fc"/>
      </svg>
    </div>
  </aside>

  <div class="flex flex-col gap-6 p-6 sm:p-10 lg:col-span-3">
    <header>
      <h1 class="text-3xl font-bold tracking-tight"><%= title %></h1>
      <p class="text-base-content/70 mt-2"><%= subtitle %></p>
    </header>

    <%= yield %>
  </div>
</section>
