<section class="card bg-base-100 border-base-300 mx-auto w-full max-w-lg border shadow-sm">
  <div class="card-body gap-6 p-6 sm:p-8">
    <header>
      <h1 class="card-title text-3xl">Forgot your password?</h1>
      <p class="text-base-content/70 mt-2">Enter your account email and we’ll send you a reset link.</p>
    </header>

    <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
      <fieldset class="fieldset">
        <%= form.label :email_address, "Email address", class: "fieldset-legend" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input w-full" %>
      </fieldset>

      <%= form.submit "Email reset instructions", class: "btn btn-primary w-full" %>
    <% end %>

    <%= link_to "Back to Sign In", new_session_path, class: "link link-primary text-center" %>
  </div>
</section>
