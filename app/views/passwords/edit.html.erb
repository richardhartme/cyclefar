<section class="card bg-base-100 border-base-300 mx-auto w-full max-w-lg border shadow-sm">
  <div class="card-body gap-6 p-6 sm:p-8">
    <header>
      <h1 class="card-title text-3xl">Update your password</h1>
      <p class="text-base-content/70 mt-2">Choose a new password for your CycleFar account.</p>
    </header>

    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
      <fieldset class="fieldset">
        <%= form.label :password, "New password", class: "fieldset-legend" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input w-full" %>
      </fieldset>

      <fieldset class="fieldset">
        <%= form.label :password_confirmation, "Confirm new password", class: "fieldset-legend" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input w-full" %>
      </fieldset>

      <%= form.submit "Save password", class: "btn btn-primary w-full" %>
    <% end %>
  </div>
</section>
