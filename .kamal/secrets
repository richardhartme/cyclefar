# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Example of extracting secrets from 1password (or another compatible pw manager)
# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY)
# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
# RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})

# Each secret below prefers an environment variable (how GitHub Actions supplies them) and
# falls back to the local Rails credentials file (how deploys from a developer machine work).
# Kamal loads this whole file for every command, so the fallback is silent when the credentials
# file is absent; the deploy workflow checks that the values it needs are present.
KAMAL_REGISTRY_PASSWORD=$(if [ -n "$KAMAL_REGISTRY_PASSWORD" ]; then echo "$KAMAL_REGISTRY_PASSWORD"; else rails credentials:fetch kamal.registry_password 2>/dev/null; fi)

# Use a GITHUB_TOKEN if private repositories are needed for the image
# GITHUB_TOKEN=$(gh config get -h github.com oauth_token)

# Grab the registry password from ENV
# KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails signs sessions and cookies with this. config/credentials.yml.enc is not committed, so the
# image has no credentials file; pass the key as an environment variable instead. This runs on
# your machine (ignored credentials file and config/master.key) or in CI (environment variable).
SECRET_KEY_BASE=$(if [ -n "$SECRET_KEY_BASE" ]; then echo "$SECRET_KEY_BASE"; else rails credentials:fetch secret_key_base 2>/dev/null; fi)

# DB Password
DB_PASSWORD=$(if [ -n "$DB_PASSWORD" ]; then echo "$DB_PASSWORD"; else rails credentials:fetch db.password 2>/dev/null; fi)

# Export these in the deploy shell (or replace with password-manager lookups).
CYCLEFAR_MAIL_FROM=$CYCLEFAR_MAIL_FROM
CYCLEFAR_SMTP_HOST=$CYCLEFAR_SMTP_HOST
CYCLEFAR_SMTP_USERNAME=$CYCLEFAR_SMTP_USERNAME
CYCLEFAR_SMTP_PASSWORD=$CYCLEFAR_SMTP_PASSWORD

# Generate once with bin/rails db:encryption:init and retain the production values.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT
